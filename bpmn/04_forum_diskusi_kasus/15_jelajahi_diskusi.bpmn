        <di:waypoint x="796" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-kosong-nihil_di" bpmnElement="f-kosong-nihil">
        <di:waypoint x="746" y="200" />
        <di:waypoint x="796" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
