      <bpmndi:BPMNShape id="perbaiki_di" bpmnElement="perbaiki">
        <dc:Bounds x="896" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_entri_di" bpmnElement="d_entri">
        <dc:Bounds x="771" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="751" y="345" width="90" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-user-mulai_di" bpmnElement="m-user-mulai">
        <di:waypoint x="78" y="410" />
        <di:waypoint x="78" y="88" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="83" y="237" width="68" height="23" />
