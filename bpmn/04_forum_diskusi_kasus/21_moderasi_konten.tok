tok 1.0 "Moderasi Konten (Forum Diskusi Kasus)"

pool p "Moderasi Konten" process=moderasi_konten
  store d_lapkon "Laporan Konten"
  store d_thread "Thread Diskusi"
  store d_komen "Komentar"
  start mulai "Laporan konten diterima" message="Laporan konten bermasalah"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  end tolak "Akses ditolak" message="Akses ditolak"
  service lapor "Laporkan Konten"
  send tinjau "Tinjau Konten Dilaporkan" message="Konten dilaporkan untuk ditinjau"
  receive keputusan "Terima keputusan moderator" message="Keputusan moderator"
  call auth2 "Otorisasi Akses" process=otorisasi_akses
  xor melanggar "Konten melanggar aturan?"
  service hapus "Hapus Konten"
  service abaikan "Tutup laporan tanpa tindakan"
  xor gabung
  end selesai "Laporan telah ditindaklanjuti" message="Hasil tindak lanjut laporan"

pool user "Pengguna"
pool admin "Admin"

flow mulai -> auth -> izin
flow izin -> lapor "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow lapor -> tinjau -> keputusan -> auth2 -> melanggar
flow melanggar -> hapus "ya" when="melanggar"
flow melanggar -> abaikan "tidak" default
flow hapus -> gabung
flow abaikan -> gabung
flow gabung -> selesai

writes lapor d_lapkon
reads tinjau d_lapkon
writes hapus d_thread
writes hapus d_komen
writes abaikan d_lapkon

message user -> mulai "Laporan konten bermasalah"
message tolak -> user "Akses ditolak"
message tinjau -> admin "Konten dilaporkan untuk ditinjau"
message admin -> keputusan "Keputusan moderator"
message selesai -> user "Hasil tindak lanjut laporan"
