<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Tambah Entri Repositori (Kelola Repositori)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Data_entri_repositori" name="Data entri repositori" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Konfirmasi_entri_tersimpan" name="Konfirmasi entri tersimpan" />
  <bpmn:dataStore id="d_entri-store" name="Entri Repositori" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Tambah Entri Repositori" processRef="tambah_entri_repositori" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Data entri repositori" sourceRef="user" targetRef="mulai" messageRef="Message_Data_entri_repositori" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-selesai-user" name="Konfirmasi entri tersimpan" sourceRef="selesai" targetRef="user" messageRef="Message_Konfirmasi_entri_tersimpan" />
  </bpmn:collaboration>
  <bpmn:process id="tambah_entri_repositori" name="Tambah Entri Repositori (Kelola Repositori)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Data entri diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Data_entri_repositori" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="kasus" name="Buat Entri Studi Kasus" />
    <bpmn:exclusiveGateway id="catat" name="Melampirkan catatan pasal?" default="f-catat-m1" />
    <bpmn:callActivity id="anotasi" name="Tampilkan Anotasi Pasal" calledElement="anotasi_teks_undang_undang">
      <bpmn:documentation>Langkah 'Tampilkan Anotasi Pasal' pada proses Anotasi Teks Undang-Undang</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:serviceTask id="lampirc" name="Lampirkan Catatan Pasal" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:exclusiveGateway id="analisis" name="Melampirkan analisis hukum?" default="f-analisis-m2" />
    <bpmn:serviceTask id="lampira" name="Lampirkan Analisis Hukum" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:serviceTask id="simpan" name="Simpan entri repositori">
      <bpmn:ioSpecification id="simpan-io">
        <bpmn:dataOutput id="simpan-out-1" name="Entri Repositori" />
        <bpmn:inputSet id="simpan-inputs" />
        <bpmn:outputSet id="simpan-outputs">
          <bpmn:dataOutputRefs>simpan-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="simpan-doa-1">
        <bpmn:sourceRef>simpan-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_entri</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Entri tersimpan di repositori">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_entri_tersimpan" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-kasus" name="ya" sourceRef="izin" targetRef="kasus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-kasus-catat" sourceRef="kasus" targetRef="catat" />
    <bpmn:sequenceFlow id="f-catat-anotasi" name="ya" sourceRef="catat" targetRef="anotasi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lampirkanCatatan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-catat-m1" name="tidak" sourceRef="catat" targetRef="m1" />
    <bpmn:sequenceFlow id="f-anotasi-lampirc" sourceRef="anotasi" targetRef="lampirc" />
    <bpmn:sequenceFlow id="f-lampirc-m1" sourceRef="lampirc" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-analisis" sourceRef="m1" targetRef="analisis" />
    <bpmn:sequenceFlow id="f-analisis-lampira" name="ya" sourceRef="analisis" targetRef="lampira">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lampirkanAnalisis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-analisis-m2" name="tidak" sourceRef="analisis" targetRef="m2" />
    <bpmn:sequenceFlow id="f-lampira-m2" sourceRef="lampira" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-simpan" sourceRef="m2" targetRef="simpan" />
    <bpmn:sequenceFlow id="f-simpan-selesai" sourceRef="simpan" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_entri" name="Entri Repositori" dataStoreRef="d_entri-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1620" height="240" />
