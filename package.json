{
  "name": "lexvera-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Platform Riset Hukum & Version Control Perundang-Undangan Indonesia (LexVera / JurisLab)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lexvera/database run db:generate",
    "db:migrate": "pnpm --filter @lexvera/database run db:migrate",
    "db:seed": "pnpm --filter @lexvera/database run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.4.2"
}
