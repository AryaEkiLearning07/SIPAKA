<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Masuk (Kelola Akun &amp; Akses)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Kredensial_login" name="Kredensial login" />
  <bpmn:message id="Message_Sesi_dan_beranda" name="Sesi dan beranda" />
  <bpmn:message id="Message_Pesan_kredensial_salah" name="Pesan kredensial salah" />
  <bpmn:message id="Message_Kredensial_ulang" name="Kredensial ulang" />
  <bpmn:message id="Message_Akun_dikunci_sementara" name="Akun dikunci sementara" />
  <bpmn:dataStore id="d_akun-store" name="Akun Pengguna" />
  <bpmn:dataStore id="d_sesi-store" name="Sesi" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Masuk" processRef="masuk" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Kredensial login" sourceRef="user" targetRef="mulai" messageRef="Message_Kredensial_login" />
    <bpmn:messageFlow id="m-sukses-user" name="Sesi dan beranda" sourceRef="sukses" targetRef="user" messageRef="Message_Sesi_dan_beranda" />
    <bpmn:messageFlow id="m-gagal-user" name="Pesan kredensial salah" sourceRef="gagal" targetRef="user" messageRef="Message_Pesan_kredensial_salah" />
    <bpmn:messageFlow id="m-user-ulang" name="Kredensial ulang" sourceRef="user" targetRef="ulang" messageRef="Message_Kredensial_ulang" />
    <bpmn:messageFlow id="m-kunci-user" name="Akun dikunci sementara" sourceRef="kunci" targetRef="user" messageRef="Message_Akun_dikunci_sementara" />
  </bpmn:collaboration>
  <bpmn:process id="masuk" name="Masuk (Kelola Akun &amp; Akses)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Kredensial diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Kredensial_login" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="verif" name="Verifikasi Kredensial">
      <bpmn:ioSpecification id="verif-io">
        <bpmn:dataInput id="verif-in-1" name="Akun Pengguna" />
        <bpmn:inputSet id="verif-inputs">
          <bpmn:dataInputRefs>verif-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="verif-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="verif-dia-1">
        <bpmn:sourceRef>d_akun</bpmn:sourceRef>
        <bpmn:targetRef>verif-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="benar" name="Kredensial benar?" default="f-benar-gagal" />
    <bpmn:serviceTask id="sesi" name="Buat Sesi">
      <bpmn:ioSpecification id="sesi-io">
        <bpmn:dataOutput id="sesi-out-2" name="Sesi" />
        <bpmn:inputSet id="sesi-inputs" />
        <bpmn:outputSet id="sesi-outputs">
          <bpmn:dataOutputRefs>sesi-out-2</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="sesi-doa-2">
        <bpmn:sourceRef>sesi-out-2</bpmn:sourceRef>
        <bpmn:targetRef>d_sesi</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="sukses" name="Pengguna masuk ke beranda">
      <bpmn:messageEventDefinition id="sukses-def" messageRef="Message_Sesi_dan_beranda" />
    </bpmn:endEvent>
    <bpmn:sendTask id="gagal" name="Tampilkan pesan kredensial salah" messageRef="Message_Pesan_kredensial_salah" />
    <bpmn:exclusiveGateway id="batas" name="Percobaan masih di bawah batas?" default="f-batas-kunci" />
    <bpmn:receiveTask id="ulang" name="Terima kredensial ulang" messageRef="Message_Kredensial_ulang" />
    <bpmn:endEvent id="kunci" name="Login ditolak sementara">
      <bpmn:messageEventDefinition id="kunci-def" messageRef="Message_Akun_dikunci_sementara" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-verif" sourceRef="mulai" targetRef="verif" />
    <bpmn:sequenceFlow id="f-verif-benar" sourceRef="verif" targetRef="benar" />
    <bpmn:sequenceFlow id="f-benar-sesi" name="ya" sourceRef="benar" targetRef="sesi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">kredensialBenar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-benar-gagal" name="tidak" sourceRef="benar" targetRef="gagal" />
    <bpmn:sequenceFlow id="f-sesi-sukses" sourceRef="sesi" targetRef="sukses" />
    <bpmn:sequenceFlow id="f-gagal-batas" sourceRef="gagal" targetRef="batas" />
    <bpmn:sequenceFlow id="f-batas-ulang" name="ya" sourceRef="batas" targetRef="ulang">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">percobaan &lt; batasPercobaan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-batas-kunci" name="tidak" sourceRef="batas" targetRef="kunci" />
    <bpmn:sequenceFlow id="f-ulang-verif" sourceRef="ulang" targetRef="verif" />
    <bpmn:dataStoreReference id="d_akun" name="Akun Pengguna" dataStoreRef="d_akun-store" />
    <bpmn:dataStoreReference id="d_sesi" name="Sesi" dataStoreRef="d_sesi-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="780" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="0" y="410" width="780" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="60" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="26" width="56" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verif_di" bpmnElement="verif">
        <dc:Bounds x="146" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="benar_di" bpmnElement="benar" isMarkerVisible="true">
        <dc:Bounds x="296" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="327" y="98" width="56" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sesi_di" bpmnElement="sesi">
