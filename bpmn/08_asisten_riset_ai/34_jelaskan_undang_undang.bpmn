<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Jelaskan Undang-Undang (Asisten Riset AI)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Pasal_atau_linimasa_yang_dijelaskan" name="Pasal atau linimasa yang dijelaskan" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Pesan_penjelasan_gagal" name="Pesan penjelasan gagal" />
  <bpmn:message id="Message_Penjelasan_AI" name="Penjelasan AI" />
  <bpmn:message id="Message_Permintaan_simpan_ke_repositori" name="Permintaan simpan ke repositori" />
  <bpmn:message id="Message_Selesai_membaca" name="Selesai membaca" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Jelaskan Undang-Undang" processRef="jelaskan_undang_undang" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Pasal atau linimasa yang dijelaskan" sourceRef="user" targetRef="mulai" messageRef="Message_Pasal_atau_linimasa_yang_dijelaskan" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-gagal-user" name="Pesan penjelasan gagal" sourceRef="gagal" targetRef="user" messageRef="Message_Pesan_penjelasan_gagal" />
    <bpmn:messageFlow id="m-hasil-user" name="Penjelasan AI" sourceRef="hasil" targetRef="user" messageRef="Message_Penjelasan_AI" />
    <bpmn:messageFlow id="m-user-simpan" name="Permintaan simpan ke repositori" sourceRef="user" targetRef="simpan" messageRef="Message_Permintaan_simpan_ke_repositori" />
    <bpmn:messageFlow id="m-user-tutup" name="Selesai membaca" sourceRef="user" targetRef="tutup" messageRef="Message_Selesai_membaca" />
  </bpmn:collaboration>
  <bpmn:process id="jelaskan_undang_undang" name="Jelaskan Undang-Undang (Asisten Riset AI)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan penjelasan diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Pasal_atau_linimasa_yang_dijelaskan" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="jenis" name="Jenis penjelasan?" default="f-jenis-ringkas" />
    <bpmn:serviceTask id="makna" name="Jelaskan Makna Pasal">
      <bpmn:ioSpecification id="makna-io">
        <bpmn:dataInput id="makna-in-1" name="Undang-Undang" />
        <bpmn:inputSet id="makna-inputs">
          <bpmn:dataInputRefs>makna-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="makna-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="makna-dia-1">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>makna-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="ringkas" name="Ringkas Linimasa Amandemen">
      <bpmn:startEvent id="r1" name="Mulai meringkas linimasa" />
      <bpmn:callActivity id="r2" name="Kelompokkan Amandemen per Tahun" calledElement="lacak_amandemen">
        <bpmn:documentation>Langkah 'Kelompokkan Amandemen per Tahun' pada proses Lacak Amandemen</bpmn:documentation>
      </bpmn:callActivity>
      <bpmn:callActivity id="r3" name="Ambil Riwayat Perubahan" calledElement="lacak_amandemen">
        <bpmn:documentation>Langkah 'Ambil Riwayat Perubahan' pada proses Lacak Amandemen</bpmn:documentation>
      </bpmn:callActivity>
      <bpmn:endEvent id="r4" name="Bahan linimasa siap" />
      <bpmn:sequenceFlow id="f-r1-r2" sourceRef="r1" targetRef="r2" />
      <bpmn:sequenceFlow id="f-r2-r3" sourceRef="r2" targetRef="r3" />
      <bpmn:sequenceFlow id="f-r3-r4" sourceRef="r3" targetRef="r4" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:callActivity id="ai" name="Tangani Permintaan AI" calledElement="tangani_permintaan_ai" />
    <bpmn:exclusiveGateway id="berhasil" name="Respons AI berhasil?" default="f-berhasil-gagal" />
    <bpmn:endEvent id="gagal" name="Penjelasan gagal dibuat">
      <bpmn:messageEventDefinition id="gagal-def" messageRef="Message_Pesan_penjelasan_gagal" />
    </bpmn:endEvent>
    <bpmn:sendTask id="hasil" name="Kirim penjelasan AI" messageRef="Message_Penjelasan_AI" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="simpan" name="Pengguna meminta simpan ke repositori">
      <bpmn:messageEventDefinition id="simpan-def" messageRef="Message_Permintaan_simpan_ke_repositori" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tutup" name="Pengguna selesai membaca">
      <bpmn:messageEventDefinition id="tutup-def" messageRef="Message_Selesai_membaca" />
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="repo" name="Tambah Entri Repositori" calledElement="tambah_entri_repositori" />
    <bpmn:endEvent id="tersimpan" name="Penjelasan tersimpan di repositori" />
    <bpmn:endEvent id="selesai" name="Penjelasan telah dibaca" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-jenis" name="ya" sourceRef="izin" targetRef="jenis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-jenis-makna" name="makna pasal" sourceRef="jenis" targetRef="makna">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jenis = "pasal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-jenis-ringkas" name="linimasa amandemen" sourceRef="jenis" targetRef="ringkas" />
    <bpmn:sequenceFlow id="f-makna-gabung" sourceRef="makna" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-ringkas-gabung" sourceRef="ringkas" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-ai" sourceRef="gabung" targetRef="ai" />
    <bpmn:sequenceFlow id="f-ai-berhasil" sourceRef="ai" targetRef="berhasil" />
    <bpmn:sequenceFlow id="f-berhasil-hasil" name="ya" sourceRef="berhasil" targetRef="hasil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aiBerhasil</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-berhasil-gagal" name="tidak" sourceRef="berhasil" targetRef="gagal" />
    <bpmn:sequenceFlow id="f-hasil-tunggu" sourceRef="hasil" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-simpan" sourceRef="tunggu" targetRef="simpan" />
    <bpmn:sequenceFlow id="f-tunggu-tutup" sourceRef="tunggu" targetRef="tutup" />
    <bpmn:sequenceFlow id="f-simpan-repo" sourceRef="simpan" targetRef="repo" />
    <bpmn:sequenceFlow id="f-repo-tersimpan" sourceRef="repo" targetRef="tersimpan" />
    <bpmn:sequenceFlow id="f-tutup-selesai" sourceRef="tutup" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
