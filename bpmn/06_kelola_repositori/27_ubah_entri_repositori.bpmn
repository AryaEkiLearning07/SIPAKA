<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Ubah Entri Repositori (Kelola Repositori)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Entri_dan_perubahannya" name="Entri dan perubahannya" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Perubahan_ditolak" name="Perubahan ditolak" />
  <bpmn:message id="Message_Konfirmasi_entri_diperbarui" name="Konfirmasi entri diperbarui" />
  <bpmn:message id="Message_Pesan_kesalahan_isi_entri" name="Pesan kesalahan isi entri" />
  <bpmn:message id="Message_Isi_entri_diperbaiki" name="Isi entri diperbaiki" />
  <bpmn:dataStore id="d_entri-store" name="Entri Repositori" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Ubah Entri Repositori" processRef="ubah_entri_repositori" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Entri dan perubahannya" sourceRef="user" targetRef="mulai" messageRef="Message_Entri_dan_perubahannya" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-bukan-user" name="Perubahan ditolak" sourceRef="bukan" targetRef="user" messageRef="Message_Perubahan_ditolak" />
    <bpmn:messageFlow id="m-selesai-user" name="Konfirmasi entri diperbarui" sourceRef="selesai" targetRef="user" messageRef="Message_Konfirmasi_entri_diperbarui" />
    <bpmn:messageFlow id="m-pesan-user" name="Pesan kesalahan isi entri" sourceRef="pesan" targetRef="user" messageRef="Message_Pesan_kesalahan_isi_entri" />
    <bpmn:messageFlow id="m-user-perbaiki" name="Isi entri diperbaiki" sourceRef="user" targetRef="perbaiki" messageRef="Message_Isi_entri_diperbaiki" />
  </bpmn:collaboration>
  <bpmn:process id="ubah_entri_repositori" name="Ubah Entri Repositori (Kelola Repositori)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Perubahan entri diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Entri_dan_perubahannya" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="pemilik" name="Pengguna pemilik entri?" default="f-pemilik-bukan" />
    <bpmn:endEvent id="bukan" name="Perubahan ditolak: bukan pemilik">
      <bpmn:messageEventDefinition id="bukan-def" messageRef="Message_Perubahan_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="valid" name="Validasi isi entri" />
    <bpmn:exclusiveGateway id="ok" name="Isi entri valid?" default="f-ok-pesan" />
    <bpmn:serviceTask id="simpan" name="Ubah Entri Repositori">
      <bpmn:ioSpecification id="simpan-io">
        <bpmn:dataOutput id="simpan-out-1" name="Entri Repositori" />
        <bpmn:inputSet id="simpan-inputs" />
        <bpmn:outputSet id="simpan-outputs">
          <bpmn:dataOutputRefs>simpan-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="simpan-doa-1">
        <bpmn:sourceRef>simpan-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_entri</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Entri diperbarui">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_entri_diperbarui" />
    </bpmn:endEvent>
    <bpmn:sendTask id="pesan" name="Kirim pesan kesalahan isi entri" messageRef="Message_Pesan_kesalahan_isi_entri" />
    <bpmn:receiveTask id="perbaiki" name="Terima isi entri yang diperbaiki" messageRef="Message_Isi_entri_diperbaiki" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-pemilik" name="ya" sourceRef="izin" targetRef="pemilik">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-pemilik-valid" name="ya" sourceRef="pemilik" targetRef="valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pemilik</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pemilik-bukan" name="tidak" sourceRef="pemilik" targetRef="bukan" />
    <bpmn:sequenceFlow id="f-valid-ok" sourceRef="valid" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-simpan" name="ya" sourceRef="ok" targetRef="simpan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isiValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-pesan" name="tidak" sourceRef="ok" targetRef="pesan" />
    <bpmn:sequenceFlow id="f-pesan-perbaiki" sourceRef="pesan" targetRef="perbaiki" />
    <bpmn:sequenceFlow id="f-perbaiki-valid" sourceRef="perbaiki" targetRef="valid" />
    <bpmn:sequenceFlow id="f-simpan-selesai" sourceRef="simpan" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_entri" name="Entri Repositori" dataStoreRef="d_entri-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1030" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="0" y="410" width="1030" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
        <dc:Bounds x="60" y="52" width="36" height="36" />
