        <bpmndi:BPMNLabel>
          <dc:Bounds x="766" y="223" width="96" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_thread_di" bpmnElement="d_thread">
        <dc:Bounds x="421" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="339" y="310" width="80" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-user-mulai_di" bpmnElement="m-user-mulai">
        <di:waypoint x="78" y="410" />
        <di:waypoint x="78" y="88" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="83" y="237" width="90" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-tolak-user_di" bpmnElement="m-tolak-user">
        <di:waypoint x="462" y="208" />
        <di:waypoint x="478" y="208" />
        <di:waypoint x="478" y="410" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="483" y="394" width="74" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-daftar-user_di" bpmnElement="m-daftar-user">
        <di:waypoint x="746" y="78" />
        <di:waypoint x="766" y="78" />
        <di:waypoint x="766" y="410" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="771" y="394" width="80" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-kosong-user_di" bpmnElement="m-kosong-user">
