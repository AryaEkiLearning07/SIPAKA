      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="saring-dia-1_di" bpmnElement="saring-dia-1">
        <di:waypoint x="446" y="290" />
        <di:waypoint x="446" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="daftar-dia-2_di" bpmnElement="daftar-dia-2">
