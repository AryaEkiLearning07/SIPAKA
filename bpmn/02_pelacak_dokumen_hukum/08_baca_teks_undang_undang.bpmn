<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Baca Teks Undang-Undang (Pelacak Dokumen Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Permintaan_buka_teks_UU" name="Permintaan buka teks UU" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Teks_konsolidasi_UU" name="Teks konsolidasi UU" />
  <bpmn:message id="Message_Panel_bab_dan_pasal" name="Panel bab dan pasal" />
  <bpmn:message id="Message_Klik_rujukan_pasal" name="Klik rujukan pasal" />
  <bpmn:message id="Message_Klik_istilah_Latin" name="Klik istilah Latin" />
  <bpmn:message id="Message_Tutup_teks_UU" name="Tutup teks UU" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Baca Teks Undang-Undang" processRef="baca_teks_undang_undang" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan buka teks UU" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_buka_teks_UU" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-teks-user" name="Teks konsolidasi UU" sourceRef="teks" targetRef="user" messageRef="Message_Teks_konsolidasi_UU" />
    <bpmn:messageFlow id="m-n2-user" name="Panel bab dan pasal" sourceRef="n2" targetRef="user" messageRef="Message_Panel_bab_dan_pasal" />
    <bpmn:messageFlow id="m-user-rujuk" name="Klik rujukan pasal" sourceRef="user" targetRef="rujuk" messageRef="Message_Klik_rujukan_pasal" />
    <bpmn:messageFlow id="m-user-istilah" name="Klik istilah Latin" sourceRef="user" targetRef="istilah" messageRef="Message_Klik_istilah_Latin" />
    <bpmn:messageFlow id="m-user-tutup" name="Tutup teks UU" sourceRef="user" targetRef="tutup" messageRef="Message_Tutup_teks_UU" />
  </bpmn:collaboration>
  <bpmn:process id="baca_teks_undang_undang" name="Baca Teks Undang-Undang (Pelacak Dokumen Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan teks UU diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_buka_teks_UU" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sendTask id="teks" name="Tampilkan Teks Konsolidasi" messageRef="Message_Teks_konsolidasi_UU">
      <bpmn:ioSpecification id="teks-io">
        <bpmn:dataInput id="teks-in-1" name="Undang-Undang" />
        <bpmn:inputSet id="teks-inputs">
          <bpmn:dataInputRefs>teks-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="teks-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="teks-dia-1">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>teks-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="pisah" />
    <bpmn:callActivity id="anotasi" name="Tampilkan Anotasi Pasal" calledElement="anotasi_teks_undang_undang">
      <bpmn:documentation>Langkah 'Tampilkan Anotasi Pasal' pada proses Anotasi Teks Undang-Undang</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:subProcess id="navigasi" name="Navigasi Struktur Dokumen">
      <bpmn:startEvent id="n1" name="Mulai navigasi" />
      <bpmn:sendTask id="n2" name="Tampilkan Panel Bab &amp; Pasal" messageRef="Message_Panel_bab_dan_pasal" />
      <bpmn:endEvent id="n3" name="Panel navigasi tampil" />
      <bpmn:sequenceFlow id="f-n1-n2" sourceRef="n1" targetRef="n2" />
      <bpmn:sequenceFlow id="f-n2-n3" sourceRef="n2" targetRef="n3" />
    </bpmn:subProcess>
    <bpmn:callActivity id="latin" name="Deteksi Istilah Latin" calledElement="deteksi_istilah_latin" />
    <bpmn:parallelGateway id="gabung" />
    <bpmn:exclusiveGateway id="loop" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="rujuk" name="Pengguna mengklik rujukan pasal">
      <bpmn:messageEventDefinition id="rujuk-def" messageRef="Message_Klik_rujukan_pasal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="istilah" name="Pengguna mengklik istilah Latin">
      <bpmn:messageEventDefinition id="istilah-def" messageRef="Message_Klik_istilah_Latin" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tutup" name="Pengguna menutup teks UU">
      <bpmn:messageEventDefinition id="tutup-def" messageRef="Message_Tutup_teks_UU" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="rujukan" name="Tautkan Rujukan Antarpasal">
      <bpmn:ioSpecification id="rujukan-io">
        <bpmn:dataInput id="rujukan-in-2" name="Undang-Undang" />
        <bpmn:inputSet id="rujukan-inputs">
          <bpmn:dataInputRefs>rujukan-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="rujukan-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="rujukan-dia-2">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>rujukan-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="popup" name="Tampilkan Popup Istilah" calledElement="tampilkan_popup_istilah" />
    <bpmn:endEvent id="selesai" name="Selesai membaca" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-teks" name="ya" sourceRef="izin" targetRef="teks">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-teks-pisah" sourceRef="teks" targetRef="pisah" />
    <bpmn:sequenceFlow id="f-pisah-anotasi" sourceRef="pisah" targetRef="anotasi" />
    <bpmn:sequenceFlow id="f-anotasi-gabung" sourceRef="anotasi" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-pisah-navigasi" sourceRef="pisah" targetRef="navigasi" />
    <bpmn:sequenceFlow id="f-navigasi-gabung" sourceRef="navigasi" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-pisah-latin" sourceRef="pisah" targetRef="latin" />
    <bpmn:sequenceFlow id="f-latin-gabung" sourceRef="latin" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-loop" sourceRef="gabung" targetRef="loop" />
    <bpmn:sequenceFlow id="f-loop-tunggu" sourceRef="loop" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-rujuk" sourceRef="tunggu" targetRef="rujuk" />
    <bpmn:sequenceFlow id="f-tunggu-istilah" sourceRef="tunggu" targetRef="istilah" />
    <bpmn:sequenceFlow id="f-tunggu-tutup" sourceRef="tunggu" targetRef="tutup" />
    <bpmn:sequenceFlow id="f-rujuk-rujukan" sourceRef="rujuk" targetRef="rujukan" />
    <bpmn:sequenceFlow id="f-rujukan-loop" sourceRef="rujukan" targetRef="loop" />
    <bpmn:sequenceFlow id="f-istilah-popup" sourceRef="istilah" targetRef="popup" />
    <bpmn:sequenceFlow id="f-popup-loop" sourceRef="popup" targetRef="loop" />
    <bpmn:sequenceFlow id="f-tutup-selesai" sourceRef="tutup" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
