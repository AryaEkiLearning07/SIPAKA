<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Cari Undang-Undang (Pelacak Dokumen Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Kueri_dan_parameter_pencarian" name="Kueri dan parameter pencarian" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Daftar_hasil_pencarian" name="Daftar hasil pencarian" />
  <bpmn:message id="Message_Pesan_hasil_tidak_ditemukan" name="Pesan hasil tidak ditemukan" />
  <bpmn:message id="Message_Kueri_pencarian_baru" name="Kueri pencarian baru" />
  <bpmn:message id="Message_Tutup_pencarian" name="Tutup pencarian" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Cari Undang-Undang" processRef="cari_undang_undang" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Kueri dan parameter pencarian" sourceRef="user" targetRef="mulai" messageRef="Message_Kueri_dan_parameter_pencarian" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-tampil-user" name="Daftar hasil pencarian" sourceRef="tampil" targetRef="user" messageRef="Message_Daftar_hasil_pencarian" />
    <bpmn:messageFlow id="m-nihil-user" name="Pesan hasil tidak ditemukan" sourceRef="nihil" targetRef="user" messageRef="Message_Pesan_hasil_tidak_ditemukan" />
    <bpmn:messageFlow id="m-user-ubah" name="Kueri pencarian baru" sourceRef="user" targetRef="ubah" messageRef="Message_Kueri_pencarian_baru" />
    <bpmn:messageFlow id="m-user-tutup" name="Tutup pencarian" sourceRef="user" targetRef="tutup" messageRef="Message_Tutup_pencarian" />
  </bpmn:collaboration>
  <bpmn:process id="cari_undang_undang" name="Cari Undang-Undang (Pelacak Dokumen Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Kueri pencarian diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Kueri_dan_parameter_pencarian" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="urai" name="Urai Kueri Pencarian" />
    <bpmn:serviceTask id="filter" name="Terapkan Filter Pencarian">
      <bpmn:ioSpecification id="filter-io">
        <bpmn:dataInput id="filter-in-1" name="Undang-Undang" />
        <bpmn:inputSet id="filter-inputs">
          <bpmn:dataInputRefs>filter-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="filter-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="filter-dia-1">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>filter-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="urut" name="Urutkan Hasil Pencarian" />
    <bpmn:exclusiveGateway id="ada" name="Ada hasil yang cocok?" default="f-ada-nihil" />
    <bpmn:sendTask id="tampil" name="Tampilkan Hasil Pencarian" messageRef="Message_Daftar_hasil_pencarian" />
    <bpmn:endEvent id="dipilih" name="Hasil pencarian terkirim" />
    <bpmn:sendTask id="nihil" name="Tampilkan pesan hasil tidak ditemukan" messageRef="Message_Pesan_hasil_tidak_ditemukan" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="ubah" name="Pengguna mengubah kueri">
      <bpmn:messageEventDefinition id="ubah-def" messageRef="Message_Kueri_pencarian_baru" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tutup" name="Pengguna menutup pencarian">
      <bpmn:messageEventDefinition id="tutup-def" messageRef="Message_Tutup_pencarian" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="kosong" name="Pencarian selesai tanpa hasil" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-urai" name="ya" sourceRef="izin" targetRef="urai">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-urai-filter" sourceRef="urai" targetRef="filter" />
    <bpmn:sequenceFlow id="f-filter-urut" sourceRef="filter" targetRef="urut" />
    <bpmn:sequenceFlow id="f-urut-ada" sourceRef="urut" targetRef="ada" />
    <bpmn:sequenceFlow id="f-ada-tampil" name="ya" sourceRef="ada" targetRef="tampil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jumlahHasil &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ada-nihil" name="tidak" sourceRef="ada" targetRef="nihil" />
    <bpmn:sequenceFlow id="f-tampil-dipilih" sourceRef="tampil" targetRef="dipilih" />
    <bpmn:sequenceFlow id="f-nihil-tunggu" sourceRef="nihil" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-ubah" sourceRef="tunggu" targetRef="ubah" />
    <bpmn:sequenceFlow id="f-tunggu-tutup" sourceRef="tunggu" targetRef="tutup" />
    <bpmn:sequenceFlow id="f-ubah-urai" sourceRef="ubah" targetRef="urai" />
    <bpmn:sequenceFlow id="f-tutup-kosong" sourceRef="tutup" targetRef="kosong" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
