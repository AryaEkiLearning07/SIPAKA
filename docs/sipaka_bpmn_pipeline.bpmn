<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SIPAKA_V2"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="SIPAKA System Architect"
                  exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_SIPAKA">
    <bpmn:participant id="Participant_SIPAKA" name="Platform SIPAKA (LexVera) — Alur Ingesti &amp; Kurasi Naskah ISO 7.5.3" processRef="Process_SIPAKA" />
  </bpmn:collaboration>

  <bpmn:process id="Process_SIPAKA" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Worker" name="Automated Worker (Daemon Ingestion)">
        <bpmn:flowNodeRef>StartEvent_Cron</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchMetadata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckExist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DownloadPDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ForkParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HashSHA256</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtractText</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ASTParse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateScore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ScoreCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Quarantine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Quarantine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyOps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveDraft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kurator" name="Kurator Hukum (Legal Reviewer &amp; ISO Quality Gate)">
        <bpmn:flowNodeRef>Task_InspectSideBySide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyOperations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CuratorDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditLogISO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishRegulation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Published</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Lane 1: Worker -->
    <bpmn:startEvent id="StartEvent_Cron" name="Scheduler Tiap 1-3 Jam">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_FetchMetadata" name="Ambil Katalog JDIHN / Setneg">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_CheckExist" name="Regulasi Ada di DB?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Duplicate</bpmn:outgoing>
      <bpmn:outgoing>Flow_New</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Duplicate" name="Abaikan (Sudah Ada)">
      <bpmn:incoming>Flow_Duplicate</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_DownloadPDF" name="Unduh PDF Resmi">
      <bpmn:incoming>Flow_New</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_ForkParallel">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_Hash</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Text</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_HashSHA256" name="Hitung SHA-256 &amp; Simpan ke MinIO">
      <bpmn:incoming>Flow_Fork_Hash</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Hash</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ExtractText" name="Ekstraksi Teks (PyMuPDF / OCR)">
      <bpmn:incoming>Flow_Fork_Text</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Text</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_JoinParallel">
      <bpmn:incoming>Flow_Join_Hash</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Text</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_ASTParse" name="AST Parsing (Bab, Pasal, Ayat)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_ValidateScore" name="Validasi Skor Kepatuhan Struktural">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_ScoreCheck" name="Skor &gt;= 70?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_FailScore</bpmn:outgoing>
      <bpmn:outgoing>Flow_PassScore</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Quarantine" name="Isolasi Dokumen ke Karantina">
      <bpmn:incoming>Flow_FailScore</bpmn:incoming>
      <bpmn:outgoing>Flow_To_QuarantineEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Quarantine" name="Menunggu Audit Manual">
      <bpmn:incoming>Flow_To_QuarantineEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_ClassifyOps" name="Klasifikasi Operasi (ADD, REPLACE, REPEAL)">
      <bpmn:incoming>Flow_PassScore</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SaveDraft" name="Simpan ChangeSet (Status: DRAFT)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Lane2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Lane 2: Kurator (Left to Right Flow) -->
    <bpmn:userTask id="Task_InspectSideBySide" name="Inspeksi Side-by-Side (PDF vs Draf AST)">
      <bpmn:incoming>Flow_To_Lane2</bpmn:incoming>
      <bpmn:incoming>Flow_LoopCorrection</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_VerifyOperations" name="Uji Ketentuan Operasi Perubahan">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CuratorDecision" name="Keputusan Kurator?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedEdit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManualCorrection" name="Koreksi Manual Formulasi / Indeks Fraksional">
      <bpmn:incoming>Flow_NeedEdit</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopCorrection</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RejectDraft" name="Tolak Naskah &amp; Catat Alasan Penolakan">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_To_RejectEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Draf Dibatalkan">
      <bpmn:incoming>Flow_To_RejectEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_SignApproval" name="Tanda Tangan Digital Persetujuan">
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_AuditLogISO" name="Catat Bukti ke review_records (ISO 7.5.3)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PublishRegulation" name="Publikasikan Naskah &amp; Purge Cache">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_To_SuccessEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Published" name="Regulasi Aktif &amp; Terkonsolidasi">
      <bpmn:incoming>Flow_To_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Cron" targetRef="Task_FetchMetadata" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_FetchMetadata" targetRef="Gateway_CheckExist" />
    <bpmn:sequenceFlow id="Flow_Duplicate" name="Ya" sourceRef="Gateway_CheckExist" targetRef="EndEvent_Duplicate" />
    <bpmn:sequenceFlow id="Flow_New" name="Tidak" sourceRef="Gateway_CheckExist" targetRef="Task_DownloadPDF" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DownloadPDF" targetRef="Gateway_ForkParallel" />
    <bpmn:sequenceFlow id="Flow_Fork_Hash" sourceRef="Gateway_ForkParallel" targetRef="Task_HashSHA256" />
    <bpmn:sequenceFlow id="Flow_Fork_Text" sourceRef="Gateway_ForkParallel" targetRef="Task_ExtractText" />
    <bpmn:sequenceFlow id="Flow_Join_Hash" sourceRef="Task_HashSHA256" targetRef="Gateway_JoinParallel" />
    <bpmn:sequenceFlow id="Flow_Join_Text" sourceRef="Task_ExtractText" targetRef="Gateway_JoinParallel" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_JoinParallel" targetRef="Task_ASTParse" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ASTParse" targetRef="Task_ValidateScore" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ValidateScore" targetRef="Gateway_ScoreCheck" />
    <bpmn:sequenceFlow id="Flow_FailScore" name="Skor &lt; 70" sourceRef="Gateway_ScoreCheck" targetRef="Task_Quarantine" />
    <bpmn:sequenceFlow id="Flow_To_QuarantineEnd" sourceRef="Task_Quarantine" targetRef="EndEvent_Quarantine" />
    <bpmn:sequenceFlow id="Flow_PassScore" name="Lolos" sourceRef="Gateway_ScoreCheck" targetRef="Task_ClassifyOps" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ClassifyOps" targetRef="Task_SaveDraft" />
    
    <!-- Transisi Lane 1 ke Lane 2 -->
    <bpmn:sequenceFlow id="Flow_To_Lane2" sourceRef="Task_SaveDraft" targetRef="Task_InspectSideBySide" />
    
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_InspectSideBySide" targetRef="Task_VerifyOperations" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_VerifyOperations" targetRef="Gateway_CuratorDecision" />
    
    <bpmn:sequenceFlow id="Flow_NeedEdit" name="Perlu Revisi" sourceRef="Gateway_CuratorDecision" targetRef="Task_ManualCorrection" />
    <bpmn:sequenceFlow id="Flow_LoopCorrection" sourceRef="Task_ManualCorrection" targetRef="Task_InspectSideBySide" />
    
    <bpmn:sequenceFlow id="Flow_Reject" name="Tolak Naskah" sourceRef="Gateway_CuratorDecision" targetRef="Task_RejectDraft" />
    <bpmn:sequenceFlow id="Flow_To_RejectEnd" sourceRef="Task_RejectDraft" targetRef="EndEvent_Rejected" />
    
    <bpmn:sequenceFlow id="Flow_Approve" name="Setujui" sourceRef="Gateway_CuratorDecision" targetRef="Task_SignApproval" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SignApproval" targetRef="Task_AuditLogISO" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AuditLogISO" targetRef="Task_PublishRegulation" />
    <bpmn:sequenceFlow id="Flow_To_SuccessEnd" sourceRef="Task_PublishRegulation" targetRef="EndEvent_Published" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_SIPAKA_V2">
    <bpmndi:BPMNPlane id="BPMNPlane_SIPAKA_V2" bpmnElement="Collaboration_SIPAKA">
      <!-- Pool & Lanes (Lapang & Rapi) -->
      <bpmndi:BPMNShape id="Participant_SIPAKA_di" bpmnElement="Participant_SIPAKA" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1800" height="660" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Worker_di" bpmnElement="Lane_Worker" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1770" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kurator_di" bpmnElement="Lane_Kurator" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="1770" height="320" />
      </bpmndi:BPMNShape>

      <!-- Lane 1 Elements (Worker) -->
      <bpmndi:BPMNShape id="StartEvent_Cron_di" bpmnElement="StartEvent_Cron">
        <dc:Bounds x="242" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="220" y="245" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FetchMetadata_di" bpmnElement="Task_FetchMetadata">
        <dc:Bounds x="320" y="180" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_CheckExist_di" bpmnElement="Gateway_CheckExist" isMarkerVisible="true">
        <dc:Bounds x="475" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="461" y="165" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Duplicate_di" bpmnElement="EndEvent_Duplicate">
        <dc:Bounds x="482" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="465" y="355" width="71" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_DownloadPDF_di" bpmnElement="Task_DownloadPDF">
        <dc:Bounds x="570" y="180" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ForkParallel_di" bpmnElement="Gateway_ForkParallel">
        <dc:Bounds x="725" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_HashSHA256_di" bpmnElement="Task_HashSHA256">
        <dc:Bounds x="815" y="115" width="125" height="75" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ExtractText_di" bpmnElement="Task_ExtractText">
        <dc:Bounds x="815" y="245" width="125" height="75" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_JoinParallel_di" bpmnElement="Gateway_JoinParallel">
        <dc:Bounds x="975" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ASTParse_di" bpmnElement="Task_ASTParse">
        <dc:Bounds x="1065" y="180" width="115" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidateScore_di" bpmnElement="Task_ValidateScore">
        <dc:Bounds x="1220" y="180" width="115" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ScoreCheck_di" bpmnElement="Gateway_ScoreCheck" isMarkerVisible="true">
        <dc:Bounds x="1375" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1370" y="165" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Quarantine_di" bpmnElement="Task_Quarantine">
        <dc:Bounds x="1345" y="295" width="110" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Quarantine_di" bpmnElement="EndEvent_Quarantine">
        <dc:Bounds x="1482" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1460" y="355" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ClassifyOps_di" bpmnElement="Task_ClassifyOps">
        <dc:Bounds x="1470" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SaveDraft_di" bpmnElement="Task_SaveDraft">
        <dc:Bounds x="1630" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Lane 2 Elements (Kurator — Rapi dari Kiri ke Kanan) -->
      <bpmndi:BPMNShape id="Task_InspectSideBySide_di" bpmnElement="Task_InspectSideBySide">
        <dc:Bounds x="320" y="500" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_VerifyOperations_di" bpmnElement="Task_VerifyOperations">
        <dc:Bounds x="490" y="500" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_CuratorDecision_di" bpmnElement="Gateway_CuratorDecision" isMarkerVisible="true">
        <dc:Bounds x="665" y="515" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="662" y="485" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ManualCorrection_di" bpmnElement="Task_ManualCorrection">
        <dc:Bounds x="630" y="625" width="120" height="75" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RejectDraft_di" bpmnElement="Task_RejectDraft">
        <dc:Bounds x="780" y="625" width="110" height="75" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="922" y="644" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="903" y="687" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SignApproval_di" bpmnElement="Task_SignApproval">
        <dc:Bounds x="780" y="500" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AuditLogISO_di" bpmnElement="Task_AuditLogISO">
        <dc:Bounds x="950" y="500" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PublishRegulation_di" bpmnElement="Task_PublishRegulation">
        <dc:Bounds x="1120" y="500" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Published_di" bpmnElement="EndEvent_Published">
        <dc:Bounds x="1292" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1272" y="565" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges Lane 1 -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="220" />
        <di:waypoint x="320" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="220" />
        <di:waypoint x="475" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Duplicate_di" bpmnElement="Flow_Duplicate">
        <di:waypoint x="500" y="245" />
        <di:waypoint x="500" y="312" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="508" y="272" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_New_di" bpmnElement="Flow_New">
        <di:waypoint x="525" y="220" />
        <di:waypoint x="570" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="535" y="202" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="680" y="220" />
        <di:waypoint x="725" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork_Hash_di" bpmnElement="Flow_Fork_Hash">
        <di:waypoint x="750" y="195" />
        <di:waypoint x="750" y="152" />
        <di:waypoint x="815" y="152" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork_Text_di" bpmnElement="Flow_Fork_Text">
        <di:waypoint x="750" y="245" />
        <di:waypoint x="750" y="282" />
        <di:waypoint x="815" y="282" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Hash_di" bpmnElement="Flow_Join_Hash">
        <di:waypoint x="940" y="152" />
        <di:waypoint x="1000" y="152" />
        <di:waypoint x="1000" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Text_di" bpmnElement="Flow_Join_Text">
        <di:waypoint x="940" y="282" />
        <di:waypoint x="1000" y="282" />
        <di:waypoint x="1000" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1025" y="220" />
