        <bpmndi:BPMNLabel>
          <dc:Bounds x="617" y="336" width="74" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_akun_di" bpmnElement="d_akun">
        <dc:Bounds x="171" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="159" y="230" width="74" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_sesi_di" bpmnElement="d_sesi">
        <dc:Bounds x="421" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="434" y="345" width="24" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-user-mulai_di" bpmnElement="m-user-mulai">
        <di:waypoint x="78" y="410" />
        <di:waypoint x="78" y="88" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="83" y="394" width="90" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-sukses-user_di" bpmnElement="m-sukses-user">
        <di:waypoint x="587" y="78" />
        <di:waypoint x="603" y="78" />
        <di:waypoint x="603" y="410" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="66" width="90" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-gagal-user_di" bpmnElement="m-gagal-user">
