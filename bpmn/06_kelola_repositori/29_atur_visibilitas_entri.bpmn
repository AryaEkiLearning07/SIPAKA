      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_entri_di" bpmnElement="d_entri">
        <dc:Bounds x="521" y="246" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="518" y="301" width="56" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
