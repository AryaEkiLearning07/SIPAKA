<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lihat Detail Undang-Undang (Pelacak Dokumen Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Permintaan_detail_UU" name="Permintaan detail UU" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Metadata_UU" name="Metadata UU" />
  <bpmn:message id="Message_Status_keberlakuan_UU" name="Status keberlakuan UU" />
  <bpmn:message id="Message_Permintaan_unduh_PDF" name="Permintaan unduh PDF" />
  <bpmn:message id="Message_Tutup_detail_UU" name="Tutup detail UU" />
  <bpmn:message id="Message_Berkas_PDF_asli" name="Berkas PDF asli" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Lihat Detail Undang-Undang" processRef="lihat_detail_undang_undang" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan detail UU" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_detail_UU" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-meta-user" name="Metadata UU" sourceRef="meta" targetRef="user" messageRef="Message_Metadata_UU" />
    <bpmn:messageFlow id="m-status-user" name="Status keberlakuan UU" sourceRef="status" targetRef="user" messageRef="Message_Status_keberlakuan_UU" />
    <bpmn:messageFlow id="m-user-unduh" name="Permintaan unduh PDF" sourceRef="user" targetRef="unduh" messageRef="Message_Permintaan_unduh_PDF" />
    <bpmn:messageFlow id="m-user-tutup" name="Tutup detail UU" sourceRef="user" targetRef="tutup" messageRef="Message_Tutup_detail_UU" />
    <bpmn:messageFlow id="m-pdf-user" name="Berkas PDF asli" sourceRef="pdf" targetRef="user" messageRef="Message_Berkas_PDF_asli" />
  </bpmn:collaboration>
  <bpmn:process id="lihat_detail_undang_undang" name="Lihat Detail Undang-Undang (Pelacak Dokumen Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan detail UU diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_detail_UU" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:parallelGateway id="pisah" />
    <bpmn:sendTask id="meta" name="Tampilkan Metadata UU" messageRef="Message_Metadata_UU">
      <bpmn:ioSpecification id="meta-io">
        <bpmn:dataInput id="meta-in-1" name="Undang-Undang" />
        <bpmn:inputSet id="meta-inputs">
          <bpmn:dataInputRefs>meta-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="meta-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="meta-dia-1">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>meta-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:sendTask id="status" name="Tampilkan Status Keberlakuan" messageRef="Message_Status_keberlakuan_UU">
      <bpmn:ioSpecification id="status-io">
        <bpmn:dataInput id="status-in-2" name="Undang-Undang" />
        <bpmn:inputSet id="status-inputs">
          <bpmn:dataInputRefs>status-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="status-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="status-dia-2">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>status-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="gabung" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="unduh" name="Pengguna meminta unduh PDF">
      <bpmn:messageEventDefinition id="unduh-def" messageRef="Message_Permintaan_unduh_PDF" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tutup" name="Pengguna menutup detail UU">
      <bpmn:messageEventDefinition id="tutup-def" messageRef="Message_Tutup_detail_UU" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="pdf" name="Unduh PDF Asli" messageRef="Message_Berkas_PDF_asli">
      <bpmn:ioSpecification id="pdf-io">
        <bpmn:dataInput id="pdf-in-3" name="Undang-Undang" />
        <bpmn:inputSet id="pdf-inputs">
          <bpmn:dataInputRefs>pdf-in-3</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="pdf-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="pdf-dia-3">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>pdf-in-3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:endEvent id="terunduh" name="PDF asli terkirim" />
    <bpmn:endEvent id="selesai" name="Detail UU selesai ditampilkan" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-pisah" name="ya" sourceRef="izin" targetRef="pisah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-pisah-meta" sourceRef="pisah" targetRef="meta" />
    <bpmn:sequenceFlow id="f-meta-gabung" sourceRef="meta" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-pisah-status" sourceRef="pisah" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-gabung" sourceRef="status" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-tunggu" sourceRef="gabung" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-unduh" sourceRef="tunggu" targetRef="unduh" />
    <bpmn:sequenceFlow id="f-tunggu-tutup" sourceRef="tunggu" targetRef="tutup" />
    <bpmn:sequenceFlow id="f-unduh-pdf" sourceRef="unduh" targetRef="pdf" />
    <bpmn:sequenceFlow id="f-pdf-terunduh" sourceRef="pdf" targetRef="terunduh" />
    <bpmn:sequenceFlow id="f-tutup-selesai" sourceRef="tutup" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
