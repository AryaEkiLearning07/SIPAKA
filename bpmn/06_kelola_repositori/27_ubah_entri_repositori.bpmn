        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pemilik_di" bpmnElement="pemilik" isMarkerVisible="true">
        <dc:Bounds x="396" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="376" y="100" width="90" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bukan_di" bpmnElement="bukan">
