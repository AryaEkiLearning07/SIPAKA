  {
   "canonicalPath": "pp-no-22-tahun-1978/bab-v",
   "type": "BAB",
   "orderIndex": 5,
   "label": "BAB V",
   "title": "KETENTUAN PERALIHAN",
   "content": "",
   "versionTag": "ORIGINAL",
   "children": [
    {
     "canonicalPath": "pp-no-22-tahun-1978/pasal-9",
     "type": "PASAL",
     "orderIndex": 9,
     "label": "Pasal 9",
     "content": "",
     "versionTag": "ORIGINAL",
     "children": [
      {
       "canonicalPath": "pp-no-22-tahun-1978/pasal-9/ayat-1",
       "type": "AYAT",
       "orderIndex": 1,
       "label": "Ayat (1)",
       "content": "Struktur Organisasi Pemerintahan Wilayah Kecamatan yang berlaku sebelum berlakunya Peraturan Pemerintah ini tetap berlaku sampai dengan waktu berlakunya Peraturan Menteri Dalam Negeri yang mengatur tentang Pola Organisasi Pemerintahan Wilayah Kota Administratif Kupang.",
       "versionTag": "ORIGINAL",
       "children": []
      },
      {
       "canonicalPath": "pp-no-22-tahun-1978/pasal-9/ayat-2",
       "type": "AYAT",
       "orderIndex": 2,
       "label": "Ayat (2)",
       "content": "Segala... - - Segala Peraturan Daerah dan Keputusan-keputusan Pemerintah Daerah yang berlaku bagi Pemerintahan Wilayah Kecamatan Kupang sebelum berlakunya Peraturan Pemerintah ini tetap berlaku bagi Pemerintahan Wilayah Kota Administratif Kupang.",
       "versionTag": "ORIGINAL",
       "children": []
      },
      {
       "canonicalPath": "pp-no-22-tahun-1978/pasal-9/ayat-3",
       "type": "AYAT",
       "orderIndex": 3,
       "label": "Ayat (3)",
       "content": "Masalah-masalah yang menyangkut bidang kepegawaian, keuangan, materil, dan lain-lain yang timbul sebagai akibat perubahan status wilayah dimaksud dalam Peraturan Pemerintah ini diselesaikan oleh Bupati Kepada Daerah Tingkat II Kupang atas nama Gubernur Kepala Daerah Tingkat I Nusa Tenggara Timur.",
       "versionTag": "ORIGINAL",
