<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Anotasi Teks Undang-Undang (Pelacak Dokumen Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Pasal_dan_aksi_anotasi" name="Pasal dan aksi anotasi" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Isi_catatan_baru" name="Isi catatan baru" />
  <bpmn:message id="Message_Isi_catatan_diubah" name="Isi catatan diubah" />
  <bpmn:message id="Message_Permintaan_konfirmasi_hapus" name="Permintaan konfirmasi hapus" />
  <bpmn:message id="Message_Konfirmasi_hapus" name="Konfirmasi hapus" />
  <bpmn:message id="Message_Batal_hapus" name="Batal hapus" />
  <bpmn:message id="Message_Anotasi_pasal" name="Anotasi pasal" />
  <bpmn:message id="Message_Konfirmasi_anotasi" name="Konfirmasi anotasi" />
  <bpmn:dataStore id="d_anot-store" name="Anotasi" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Anotasi Teks Undang-Undang" processRef="anotasi_teks_undang_undang" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Pasal dan aksi anotasi" sourceRef="user" targetRef="mulai" messageRef="Message_Pasal_dan_aksi_anotasi" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-user-tulis" name="Isi catatan baru" sourceRef="user" targetRef="tulis" messageRef="Message_Isi_catatan_baru" />
    <bpmn:messageFlow id="m-user-ubahisi" name="Isi catatan diubah" sourceRef="user" targetRef="ubahisi" messageRef="Message_Isi_catatan_diubah" />
    <bpmn:messageFlow id="m-minta-user" name="Permintaan konfirmasi hapus" sourceRef="minta" targetRef="user" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:messageFlow id="m-user-ya" name="Konfirmasi hapus" sourceRef="user" targetRef="ya" messageRef="Message_Konfirmasi_hapus" />
    <bpmn:messageFlow id="m-user-tidak" name="Batal hapus" sourceRef="user" targetRef="tidak" messageRef="Message_Batal_hapus" />
    <bpmn:messageFlow id="m-tampil-user" name="Anotasi pasal" sourceRef="tampil" targetRef="user" messageRef="Message_Anotasi_pasal" />
    <bpmn:messageFlow id="m-selesai-user" name="Konfirmasi anotasi" sourceRef="selesai" targetRef="user" messageRef="Message_Konfirmasi_anotasi" />
  </bpmn:collaboration>
  <bpmn:process id="anotasi_teks_undang_undang" name="Anotasi Teks Undang-Undang (Pelacak Dokumen Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan anotasi diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Pasal_dan_aksi_anotasi" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="aksi" name="Aksi anotasi?" default="f-aksi-tanda" />
    <bpmn:receiveTask id="tulis" name="Terima isi catatan baru" messageRef="Message_Isi_catatan_baru" />
    <bpmn:serviceTask id="buat" name="Buat Anotasi">
      <bpmn:ioSpecification id="buat-io">
        <bpmn:dataOutput id="buat-out-1" name="Anotasi" />
        <bpmn:inputSet id="buat-inputs" />
        <bpmn:outputSet id="buat-outputs">
          <bpmn:dataOutputRefs>buat-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="buat-doa-1">
        <bpmn:sourceRef>buat-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_anot</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ubahisi" name="Terima isi catatan yang diubah" messageRef="Message_Isi_catatan_diubah" />
    <bpmn:serviceTask id="ubah" name="Ubah Anotasi">
      <bpmn:ioSpecification id="ubah-io">
        <bpmn:dataOutput id="ubah-out-2" name="Anotasi" />
        <bpmn:inputSet id="ubah-inputs" />
        <bpmn:outputSet id="ubah-outputs">
          <bpmn:dataOutputRefs>ubah-out-2</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="ubah-doa-2">
        <bpmn:sourceRef>ubah-out-2</bpmn:sourceRef>
        <bpmn:targetRef>d_anot</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="minta" name="Minta konfirmasi penghapusan catatan" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="ya" name="Pengguna mengonfirmasi hapus">
      <bpmn:messageEventDefinition id="ya-def" messageRef="Message_Konfirmasi_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tidak" name="Pengguna membatalkan hapus">
      <bpmn:messageEventDefinition id="tidak-def" messageRef="Message_Batal_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="hapus" name="Hapus Anotasi">
      <bpmn:ioSpecification id="hapus-io">
        <bpmn:dataOutput id="hapus-out-3" name="Anotasi" />
        <bpmn:inputSet id="hapus-inputs" />
        <bpmn:outputSet id="hapus-outputs">
          <bpmn:dataOutputRefs>hapus-out-3</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="hapus-doa-3">
        <bpmn:sourceRef>hapus-out-3</bpmn:sourceRef>
        <bpmn:targetRef>d_anot</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="tampil" name="Tampilkan Anotasi Pasal" messageRef="Message_Anotasi_pasal">
      <bpmn:ioSpecification id="tampil-io">
        <bpmn:dataInput id="tampil-in-4" name="Anotasi" />
        <bpmn:inputSet id="tampil-inputs">
          <bpmn:dataInputRefs>tampil-in-4</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="tampil-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="tampil-dia-4">
        <bpmn:sourceRef>d_anot</bpmn:sourceRef>
        <bpmn:targetRef>tampil-in-4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:serviceTask id="tanda" name="Beri Penanda Pasal">
      <bpmn:ioSpecification id="tanda-io">
        <bpmn:dataOutput id="tanda-out-5" name="Anotasi" />
        <bpmn:inputSet id="tanda-inputs" />
        <bpmn:outputSet id="tanda-outputs">
          <bpmn:dataOutputRefs>tanda-out-5</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="tanda-doa-5">
        <bpmn:sourceRef>tanda-out-5</bpmn:sourceRef>
        <bpmn:targetRef>d_anot</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:endEvent id="selesai" name="Anotasi diproses">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_anotasi" />
    </bpmn:endEvent>
    <bpmn:endEvent id="batal" name="Penghapusan dibatalkan" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-aksi" name="ya" sourceRef="izin" targetRef="aksi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-aksi-tulis" name="buat catatan" sourceRef="aksi" targetRef="tulis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "buat"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aksi-ubahisi" name="ubah catatan" sourceRef="aksi" targetRef="ubahisi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "ubah"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aksi-minta" name="hapus catatan" sourceRef="aksi" targetRef="minta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "hapus"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aksi-tampil" name="lihat catatan" sourceRef="aksi" targetRef="tampil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksi = "lihat"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aksi-tanda" name="beri penanda" sourceRef="aksi" targetRef="tanda" />
    <bpmn:sequenceFlow id="f-tulis-buat" sourceRef="tulis" targetRef="buat" />
    <bpmn:sequenceFlow id="f-buat-gabung" sourceRef="buat" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-ubahisi-ubah" sourceRef="ubahisi" targetRef="ubah" />
    <bpmn:sequenceFlow id="f-ubah-gabung" sourceRef="ubah" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-minta-tunggu" sourceRef="minta" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-ya" sourceRef="tunggu" targetRef="ya" />
    <bpmn:sequenceFlow id="f-tunggu-tidak" sourceRef="tunggu" targetRef="tidak" />
    <bpmn:sequenceFlow id="f-ya-hapus" sourceRef="ya" targetRef="hapus" />
    <bpmn:sequenceFlow id="f-hapus-gabung" sourceRef="hapus" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-tidak-batal" sourceRef="tidak" targetRef="batal" />
    <bpmn:sequenceFlow id="f-tampil-gabung" sourceRef="tampil" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-tanda-gabung" sourceRef="tanda" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-selesai" sourceRef="gabung" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_anot" name="Anotasi" dataStoreRef="d_anot-store" />
  </bpmn:process>
