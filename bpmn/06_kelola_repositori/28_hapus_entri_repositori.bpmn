<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Hapus Entri Repositori (Kelola Repositori)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Permintaan_hapus_entri" name="Permintaan hapus entri" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Penghapusan_ditolak" name="Penghapusan ditolak" />
  <bpmn:message id="Message_Permintaan_konfirmasi_hapus" name="Permintaan konfirmasi hapus" />
  <bpmn:message id="Message_Konfirmasi_hapus" name="Konfirmasi hapus" />
  <bpmn:message id="Message_Batal_hapus" name="Batal hapus" />
  <bpmn:message id="Message_Konfirmasi_entri_dihapus" name="Konfirmasi entri dihapus" />
  <bpmn:dataStore id="d_entri-store" name="Entri Repositori" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Hapus Entri Repositori" processRef="hapus_entri_repositori" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan hapus entri" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_hapus_entri" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-bukan-user" name="Penghapusan ditolak" sourceRef="bukan" targetRef="user" messageRef="Message_Penghapusan_ditolak" />
    <bpmn:messageFlow id="m-minta-user" name="Permintaan konfirmasi hapus" sourceRef="minta" targetRef="user" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:messageFlow id="m-user-ya" name="Konfirmasi hapus" sourceRef="user" targetRef="ya" messageRef="Message_Konfirmasi_hapus" />
    <bpmn:messageFlow id="m-user-tidak" name="Batal hapus" sourceRef="user" targetRef="tidak" messageRef="Message_Batal_hapus" />
    <bpmn:messageFlow id="m-selesai-user" name="Konfirmasi entri dihapus" sourceRef="selesai" targetRef="user" messageRef="Message_Konfirmasi_entri_dihapus" />
  </bpmn:collaboration>
  <bpmn:process id="hapus_entri_repositori" name="Hapus Entri Repositori (Kelola Repositori)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan hapus entri diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_hapus_entri" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="pemilik" name="Pengguna pemilik entri?" default="f-pemilik-bukan" />
    <bpmn:endEvent id="bukan" name="Penghapusan ditolak: bukan pemilik">
      <bpmn:messageEventDefinition id="bukan-def" messageRef="Message_Penghapusan_ditolak" />
    </bpmn:endEvent>
    <bpmn:sendTask id="minta" name="Minta konfirmasi penghapusan" messageRef="Message_Permintaan_konfirmasi_hapus" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="ya" name="Pengguna mengonfirmasi hapus">
      <bpmn:messageEventDefinition id="ya-def" messageRef="Message_Konfirmasi_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tidak" name="Pengguna membatalkan hapus">
      <bpmn:messageEventDefinition id="tidak-def" messageRef="Message_Batal_hapus" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="hapus" name="Hapus Entri Repositori">
      <bpmn:ioSpecification id="hapus-io">
        <bpmn:dataOutput id="hapus-out-1" name="Entri Repositori" />
        <bpmn:inputSet id="hapus-inputs" />
        <bpmn:outputSet id="hapus-outputs">
          <bpmn:dataOutputRefs>hapus-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="hapus-doa-1">
        <bpmn:sourceRef>hapus-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_entri</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Entri dihapus">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_entri_dihapus" />
    </bpmn:endEvent>
    <bpmn:endEvent id="batal" name="Penghapusan dibatalkan" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-pemilik" name="ya" sourceRef="izin" targetRef="pemilik">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-pemilik-minta" name="ya" sourceRef="pemilik" targetRef="minta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pemilik</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pemilik-bukan" name="tidak" sourceRef="pemilik" targetRef="bukan" />
    <bpmn:sequenceFlow id="f-minta-tunggu" sourceRef="minta" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-ya" sourceRef="tunggu" targetRef="ya" />
    <bpmn:sequenceFlow id="f-tunggu-tidak" sourceRef="tunggu" targetRef="tidak" />
    <bpmn:sequenceFlow id="f-ya-hapus" sourceRef="ya" targetRef="hapus" />
    <bpmn:sequenceFlow id="f-hapus-selesai" sourceRef="hapus" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-tidak-batal" sourceRef="tidak" targetRef="batal" />
    <bpmn:dataStoreReference id="d_entri" name="Entri Repositori" dataStoreRef="d_entri-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1050" height="330" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_di" bpmnElement="user" isHorizontal="true">
        <dc:Bounds x="0" y="370" width="1050" height="70" />
