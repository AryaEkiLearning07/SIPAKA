<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lihat Thread Diskusi (Forum Diskusi Kasus)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Permintaan_buka_thread" name="Permintaan buka thread" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Isi_thread" name="Isi thread" />
  <bpmn:message id="Message_Lencana_verifikasi" name="Lencana verifikasi" />
  <bpmn:message id="Message_Klik_istilah_Latin" name="Klik istilah Latin" />
  <bpmn:message id="Message_Tutup_thread" name="Tutup thread" />
  <bpmn:dataStore id="d_thread-store" name="Thread Diskusi" />
  <bpmn:dataStore id="d_komen-store" name="Komentar" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Lihat Thread Diskusi" processRef="lihat_thread_diskusi" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Permintaan buka thread" sourceRef="user" targetRef="mulai" messageRef="Message_Permintaan_buka_thread" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-isi-user" name="Isi thread" sourceRef="isi" targetRef="user" messageRef="Message_Isi_thread" />
    <bpmn:messageFlow id="m-lencana-user" name="Lencana verifikasi" sourceRef="lencana" targetRef="user" messageRef="Message_Lencana_verifikasi" />
    <bpmn:messageFlow id="m-user-istilah" name="Klik istilah Latin" sourceRef="user" targetRef="istilah" messageRef="Message_Klik_istilah_Latin" />
    <bpmn:messageFlow id="m-user-tutup" name="Tutup thread" sourceRef="user" targetRef="tutup" messageRef="Message_Tutup_thread" />
  </bpmn:collaboration>
  <bpmn:process id="lihat_thread_diskusi" name="Lihat Thread Diskusi (Forum Diskusi Kasus)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan buka thread diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Permintaan_buka_thread" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sendTask id="isi" name="Tampilkan Isi Thread" messageRef="Message_Isi_thread">
      <bpmn:ioSpecification id="isi-io">
        <bpmn:dataInput id="isi-in-1" name="Thread Diskusi" />
        <bpmn:inputSet id="isi-inputs">
          <bpmn:dataInputRefs>isi-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="isi-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="isi-dia-1">
        <bpmn:sourceRef>d_thread</bpmn:sourceRef>
        <bpmn:targetRef>isi-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="pisah" />
    <bpmn:serviceTask id="urut" name="Urutkan Komentar">
      <bpmn:ioSpecification id="urut-io">
        <bpmn:dataInput id="urut-in-2" name="Komentar" />
        <bpmn:inputSet id="urut-inputs">
          <bpmn:dataInputRefs>urut-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="urut-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="urut-dia-2">
        <bpmn:sourceRef>d_komen</bpmn:sourceRef>
        <bpmn:targetRef>urut-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="lencana" name="Tampilkan Lencana Verifikasi" messageRef="Message_Lencana_verifikasi">
      <bpmn:ioSpecification id="lencana-io">
        <bpmn:dataInput id="lencana-in-3" name="Komentar" />
        <bpmn:inputSet id="lencana-inputs">
          <bpmn:dataInputRefs>lencana-in-3</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="lencana-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="lencana-dia-3">
        <bpmn:sourceRef>d_komen</bpmn:sourceRef>
        <bpmn:targetRef>lencana-in-3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:callActivity id="latin" name="Deteksi Istilah Latin" calledElement="deteksi_istilah_latin" />
    <bpmn:parallelGateway id="gabung" />
    <bpmn:exclusiveGateway id="loop" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="istilah" name="Pengguna mengklik istilah Latin">
      <bpmn:messageEventDefinition id="istilah-def" messageRef="Message_Klik_istilah_Latin" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tutup" name="Pengguna menutup thread">
      <bpmn:messageEventDefinition id="tutup-def" messageRef="Message_Tutup_thread" />
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="popup" name="Tampilkan Popup Istilah" calledElement="tampilkan_popup_istilah" />
    <bpmn:endEvent id="selesai" name="Selesai membaca thread" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-isi" name="ya" sourceRef="izin" targetRef="isi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-isi-pisah" sourceRef="isi" targetRef="pisah" />
    <bpmn:sequenceFlow id="f-pisah-urut" sourceRef="pisah" targetRef="urut" />
    <bpmn:sequenceFlow id="f-urut-gabung" sourceRef="urut" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-pisah-lencana" sourceRef="pisah" targetRef="lencana" />
    <bpmn:sequenceFlow id="f-lencana-gabung" sourceRef="lencana" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-pisah-latin" sourceRef="pisah" targetRef="latin" />
    <bpmn:sequenceFlow id="f-latin-gabung" sourceRef="latin" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-loop" sourceRef="gabung" targetRef="loop" />
    <bpmn:sequenceFlow id="f-loop-tunggu" sourceRef="loop" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-istilah" sourceRef="tunggu" targetRef="istilah" />
    <bpmn:sequenceFlow id="f-tunggu-tutup" sourceRef="tunggu" targetRef="tutup" />
    <bpmn:sequenceFlow id="f-istilah-popup" sourceRef="istilah" targetRef="popup" />
    <bpmn:sequenceFlow id="f-popup-loop" sourceRef="popup" targetRef="loop" />
    <bpmn:sequenceFlow id="f-tutup-selesai" sourceRef="tutup" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_thread" name="Thread Diskusi" dataStoreRef="d_thread-store" />
    <bpmn:dataStoreReference id="d_komen" name="Komentar" dataStoreRef="d_komen-store" />
  </bpmn:process>
