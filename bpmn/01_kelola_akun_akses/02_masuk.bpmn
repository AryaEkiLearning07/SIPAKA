        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="93" width="46" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gagal_di" bpmnElement="gagal">
        <dc:Bounds x="396" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="batas_di" bpmnElement="batas" isMarkerVisible="true">
        <dc:Bounds x="546" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="138" width="68" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
