<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Temukan Kasus Serupa (Asisten Riset AI)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Deskripsi_kasus" name="Deskripsi kasus" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Pesan_pencarian_kasus_gagal" name="Pesan pencarian kasus gagal" />
  <bpmn:message id="Message_Kasus_serupa_dan_riwayat_penanganannya" name="Kasus serupa dan riwayat penanganannya" />
  <bpmn:message id="Message_Permintaan_simpan_ke_repositori" name="Permintaan simpan ke repositori" />
  <bpmn:message id="Message_Selesai_membaca" name="Selesai membaca" />
  <bpmn:dataStore id="d_thread-store" name="Thread Diskusi" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Temukan Kasus Serupa" processRef="temukan_kasus_serupa" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Deskripsi kasus" sourceRef="user" targetRef="mulai" messageRef="Message_Deskripsi_kasus" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-gagal-user" name="Pesan pencarian kasus gagal" sourceRef="gagal" targetRef="user" messageRef="Message_Pesan_pencarian_kasus_gagal" />
    <bpmn:messageFlow id="m-riwayat-user" name="Kasus serupa dan riwayat penanganannya" sourceRef="riwayat" targetRef="user" messageRef="Message_Kasus_serupa_dan_riwayat_penanganannya" />
    <bpmn:messageFlow id="m-user-simpan" name="Permintaan simpan ke repositori" sourceRef="user" targetRef="simpan" messageRef="Message_Permintaan_simpan_ke_repositori" />
    <bpmn:messageFlow id="m-user-tutup" name="Selesai membaca" sourceRef="user" targetRef="tutup" messageRef="Message_Selesai_membaca" />
  </bpmn:collaboration>
  <bpmn:process id="temukan_kasus_serupa" name="Temukan Kasus Serupa (Asisten Riset AI)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Deskripsi kasus diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Deskripsi_kasus" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="fakta" name="Ekstrak Fakta Kasus" />
    <bpmn:callActivity id="ai" name="Tangani Permintaan AI" calledElement="tangani_permintaan_ai" />
    <bpmn:exclusiveGateway id="berhasil" name="Respons AI berhasil?" default="f-berhasil-gagal" />
    <bpmn:endEvent id="gagal" name="Pencarian kasus serupa gagal">
      <bpmn:messageEventDefinition id="gagal-def" messageRef="Message_Pesan_pencarian_kasus_gagal" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="paralel" name="Ambil Kasus Paralel">
      <bpmn:ioSpecification id="paralel-io">
        <bpmn:dataInput id="paralel-in-1" name="Thread Diskusi" />
        <bpmn:inputSet id="paralel-inputs">
          <bpmn:dataInputRefs>paralel-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="paralel-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="paralel-dia-1">
        <bpmn:sourceRef>d_thread</bpmn:sourceRef>
        <bpmn:targetRef>paralel-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="riwayat" name="Tampilkan Riwayat Penanganan Kasus" messageRef="Message_Kasus_serupa_dan_riwayat_penanganannya" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="simpan" name="Pengguna meminta simpan ke repositori">
      <bpmn:messageEventDefinition id="simpan-def" messageRef="Message_Permintaan_simpan_ke_repositori" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tutup" name="Pengguna selesai belajar">
      <bpmn:messageEventDefinition id="tutup-def" messageRef="Message_Selesai_membaca" />
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="repo" name="Tambah Entri Repositori" calledElement="tambah_entri_repositori" />
    <bpmn:endEvent id="tersimpan" name="Hasil tersimpan di repositori" />
    <bpmn:endEvent id="selesai" name="Studi kasus selesai" />
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-fakta" name="ya" sourceRef="izin" targetRef="fakta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-fakta-ai" sourceRef="fakta" targetRef="ai" />
    <bpmn:sequenceFlow id="f-ai-berhasil" sourceRef="ai" targetRef="berhasil" />
    <bpmn:sequenceFlow id="f-berhasil-paralel" name="ya" sourceRef="berhasil" targetRef="paralel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aiBerhasil</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-berhasil-gagal" name="tidak" sourceRef="berhasil" targetRef="gagal" />
    <bpmn:sequenceFlow id="f-paralel-riwayat" sourceRef="paralel" targetRef="riwayat" />
    <bpmn:sequenceFlow id="f-riwayat-tunggu" sourceRef="riwayat" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-simpan" sourceRef="tunggu" targetRef="simpan" />
    <bpmn:sequenceFlow id="f-tunggu-tutup" sourceRef="tunggu" targetRef="tutup" />
    <bpmn:sequenceFlow id="f-simpan-repo" sourceRef="simpan" targetRef="repo" />
    <bpmn:sequenceFlow id="f-repo-tersimpan" sourceRef="repo" targetRef="tersimpan" />
    <bpmn:sequenceFlow id="f-tutup-selesai" sourceRef="tutup" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_thread" name="Thread Diskusi" dataStoreRef="d_thread-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
