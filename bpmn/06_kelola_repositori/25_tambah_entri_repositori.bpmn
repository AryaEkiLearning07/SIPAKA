      <bpmndi:BPMNShape id="selesai_di" bpmnElement="selesai">
        <dc:Bounds x="1546" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1530" y="14" width="68" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_entri_di" bpmnElement="d_entri">
