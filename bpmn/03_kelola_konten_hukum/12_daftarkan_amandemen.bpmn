<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Daftarkan Amandemen (Kelola Konten Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_UU_induk_dan_UU_pengubah" name="UU induk dan UU pengubah" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Tidak_ada_perubahan" name="Tidak ada perubahan" />
  <bpmn:message id="Message_Hasil_konsolidasi" name="Hasil konsolidasi" />
  <bpmn:message id="Message_Persetujuan_konsolidasi" name="Persetujuan konsolidasi" />
  <bpmn:message id="Message_Koreksi_ketentuan" name="Koreksi ketentuan" />
  <bpmn:message id="Message_Konfirmasi_amandemen_terdaftar" name="Konfirmasi amandemen terdaftar" />
  <bpmn:dataStore id="d_riw-store" name="Riwayat Perubahan UU" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Daftarkan Amandemen" processRef="daftarkan_amandemen" />
    <bpmn:participant id="admin" name="Admin" />
    <bpmn:messageFlow id="m-admin-mulai" name="UU induk dan UU pengubah" sourceRef="admin" targetRef="mulai" messageRef="Message_UU_induk_dan_UU_pengubah" />
    <bpmn:messageFlow id="m-tolak-admin" name="Akses ditolak" sourceRef="tolak" targetRef="admin" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-nihil-admin" name="Tidak ada perubahan" sourceRef="nihil" targetRef="admin" messageRef="Message_Tidak_ada_perubahan" />
    <bpmn:messageFlow id="m-tinjau-admin" name="Hasil konsolidasi" sourceRef="tinjau" targetRef="admin" messageRef="Message_Hasil_konsolidasi" />
    <bpmn:messageFlow id="m-admin-setuju" name="Persetujuan konsolidasi" sourceRef="admin" targetRef="setuju" messageRef="Message_Persetujuan_konsolidasi" />
    <bpmn:messageFlow id="m-admin-koreksi" name="Koreksi ketentuan" sourceRef="admin" targetRef="koreksi" messageRef="Message_Koreksi_ketentuan" />
    <bpmn:messageFlow id="m-selesai-admin" name="Konfirmasi amandemen terdaftar" sourceRef="selesai" targetRef="admin" messageRef="Message_Konfirmasi_amandemen_terdaftar" />
  </bpmn:collaboration>
  <bpmn:process id="daftarkan_amandemen" name="Daftarkan Amandemen (Kelola Konten Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="UU induk dan UU pengubah diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_UU_induk_dan_UU_pengubah" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="tautkan" name="Tautkan UU Pengubah">
      <bpmn:ioSpecification id="tautkan-io">
        <bpmn:dataOutput id="tautkan-out-1" name="Riwayat Perubahan UU" />
        <bpmn:inputSet id="tautkan-inputs" />
        <bpmn:outputSet id="tautkan-outputs">
          <bpmn:dataOutputRefs>tautkan-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="tautkan-doa-1">
        <bpmn:sourceRef>tautkan-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_riw</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="identifikasi" name="Identifikasi Ketentuan Baru">
      <bpmn:startEvent id="i1" name="Mulai identifikasi" />
      <bpmn:callActivity id="i2" name="Hitung Selisih Teks" calledElement="lacak_amandemen">
        <bpmn:documentation>Langkah 'Hitung Selisih Teks' pada proses Lacak Amandemen (Bandingkan Versi Pasal)</bpmn:documentation>
      </bpmn:callActivity>
      <bpmn:serviceTask id="i3" name="Kelompokkan ketentuan: ditambah, diubah, dicabut" />
      <bpmn:endEvent id="i4" name="Ketentuan teridentifikasi" />
      <bpmn:sequenceFlow id="f-i1-i2" sourceRef="i1" targetRef="i2" />
      <bpmn:sequenceFlow id="f-i2-i3" sourceRef="i2" targetRef="i3" />
      <bpmn:sequenceFlow id="f-i3-i4" sourceRef="i3" targetRef="i4" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="ada" name="Ada ketentuan yang berubah?" default="f-ada-nihil" />
    <bpmn:endEvent id="nihil" name="Tidak ada perubahan untuk didaftarkan">
      <bpmn:messageEventDefinition id="nihil-def" messageRef="Message_Tidak_ada_perubahan" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="susun" name="Susun Teks Konsolidasi">
      <bpmn:ioSpecification id="susun-io">
        <bpmn:dataInput id="susun-in-2" name="Riwayat Perubahan UU" />
        <bpmn:dataOutput id="susun-out-3" name="Undang-Undang" />
        <bpmn:inputSet id="susun-inputs">
          <bpmn:dataInputRefs>susun-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="susun-outputs">
          <bpmn:dataOutputRefs>susun-out-3</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="susun-dia-2">
        <bpmn:sourceRef>d_riw</bpmn:sourceRef>
        <bpmn:targetRef>susun-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="susun-doa-3">
        <bpmn:sourceRef>susun-out-3</bpmn:sourceRef>
        <bpmn:targetRef>d_uu</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="tinjau" name="Kirim hasil konsolidasi untuk ditinjau" messageRef="Message_Hasil_konsolidasi" />
    <bpmn:eventBasedGateway id="tunggu" />
    <bpmn:intermediateCatchEvent id="setuju" name="Admin menyetujui hasil">
      <bpmn:messageEventDefinition id="setuju-def" messageRef="Message_Persetujuan_konsolidasi" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="koreksi" name="Admin mengoreksi ketentuan">
      <bpmn:messageEventDefinition id="koreksi-def" messageRef="Message_Koreksi_ketentuan" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="status" name="Perbarui Status Keberlakuan">
      <bpmn:ioSpecification id="status-io">
        <bpmn:dataOutput id="status-out-4" name="Undang-Undang" />
        <bpmn:inputSet id="status-inputs" />
        <bpmn:outputSet id="status-outputs">
          <bpmn:dataOutputRefs>status-out-4</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="status-doa-4">
        <bpmn:sourceRef>status-out-4</bpmn:sourceRef>
        <bpmn:targetRef>d_uu</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Amandemen terdaftar">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_amandemen_terdaftar" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-tautkan" name="ya" sourceRef="izin" targetRef="tautkan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-tautkan-identifikasi" sourceRef="tautkan" targetRef="identifikasi" />
    <bpmn:sequenceFlow id="f-identifikasi-ada" sourceRef="identifikasi" targetRef="ada" />
    <bpmn:sequenceFlow id="f-ada-susun" name="ya" sourceRef="ada" targetRef="susun">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">adaPerubahan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ada-nihil" name="tidak" sourceRef="ada" targetRef="nihil" />
    <bpmn:sequenceFlow id="f-susun-tinjau" sourceRef="susun" targetRef="tinjau" />
    <bpmn:sequenceFlow id="f-tinjau-tunggu" sourceRef="tinjau" targetRef="tunggu" />
    <bpmn:sequenceFlow id="f-tunggu-setuju" sourceRef="tunggu" targetRef="setuju" />
    <bpmn:sequenceFlow id="f-tunggu-koreksi" sourceRef="tunggu" targetRef="koreksi" />
    <bpmn:sequenceFlow id="f-setuju-status" sourceRef="setuju" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-selesai" sourceRef="status" targetRef="selesai" />
    <bpmn:sequenceFlow id="f-koreksi-susun" sourceRef="koreksi" targetRef="susun" />
    <bpmn:dataStoreReference id="d_riw" name="Riwayat Perubahan UU" dataStoreRef="d_riw-store" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
