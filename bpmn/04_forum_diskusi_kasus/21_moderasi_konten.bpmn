<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Moderasi Konten (Forum Diskusi Kasus)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Laporan_konten_bermasalah" name="Laporan konten bermasalah" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Konten_dilaporkan_untuk_ditinjau" name="Konten dilaporkan untuk ditinjau" />
  <bpmn:message id="Message_Keputusan_moderator" name="Keputusan moderator" />
  <bpmn:message id="Message_Hasil_tindak_lanjut_laporan" name="Hasil tindak lanjut laporan" />
  <bpmn:dataStore id="d_lapkon-store" name="Laporan Konten" />
  <bpmn:dataStore id="d_thread-store" name="Thread Diskusi" />
  <bpmn:dataStore id="d_komen-store" name="Komentar" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Moderasi Konten" processRef="moderasi_konten" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:participant id="admin" name="Admin" />
    <bpmn:messageFlow id="m-user-mulai" name="Laporan konten bermasalah" sourceRef="user" targetRef="mulai" messageRef="Message_Laporan_konten_bermasalah" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-tinjau-admin" name="Konten dilaporkan untuk ditinjau" sourceRef="tinjau" targetRef="admin" messageRef="Message_Konten_dilaporkan_untuk_ditinjau" />
    <bpmn:messageFlow id="m-admin-keputusan" name="Keputusan moderator" sourceRef="admin" targetRef="keputusan" messageRef="Message_Keputusan_moderator" />
    <bpmn:messageFlow id="m-selesai-user" name="Hasil tindak lanjut laporan" sourceRef="selesai" targetRef="user" messageRef="Message_Hasil_tindak_lanjut_laporan" />
  </bpmn:collaboration>
  <bpmn:process id="moderasi_konten" name="Moderasi Konten (Forum Diskusi Kasus)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Laporan konten diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Laporan_konten_bermasalah" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="lapor" name="Laporkan Konten">
      <bpmn:ioSpecification id="lapor-io">
        <bpmn:dataOutput id="lapor-out-1" name="Laporan Konten" />
        <bpmn:inputSet id="lapor-inputs" />
        <bpmn:outputSet id="lapor-outputs">
          <bpmn:dataOutputRefs>lapor-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="lapor-doa-1">
        <bpmn:sourceRef>lapor-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_lapkon</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="tinjau" name="Tinjau Konten Dilaporkan" messageRef="Message_Konten_dilaporkan_untuk_ditinjau">
      <bpmn:ioSpecification id="tinjau-io">
        <bpmn:dataInput id="tinjau-in-2" name="Laporan Konten" />
        <bpmn:inputSet id="tinjau-inputs">
          <bpmn:dataInputRefs>tinjau-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="tinjau-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="tinjau-dia-2">
        <bpmn:sourceRef>d_lapkon</bpmn:sourceRef>
        <bpmn:targetRef>tinjau-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="keputusan" name="Terima keputusan moderator" messageRef="Message_Keputusan_moderator" />
    <bpmn:callActivity id="auth2" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="melanggar" name="Konten melanggar aturan?" default="f-melanggar-abaikan" />
    <bpmn:serviceTask id="hapus" name="Hapus Konten">
      <bpmn:ioSpecification id="hapus-io">
        <bpmn:dataOutput id="hapus-out-3" name="Thread Diskusi" />
        <bpmn:dataOutput id="hapus-out-4" name="Komentar" />
        <bpmn:inputSet id="hapus-inputs" />
        <bpmn:outputSet id="hapus-outputs">
          <bpmn:dataOutputRefs>hapus-out-3</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>hapus-out-4</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="hapus-doa-3">
        <bpmn:sourceRef>hapus-out-3</bpmn:sourceRef>
        <bpmn:targetRef>d_thread</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="hapus-doa-4">
        <bpmn:sourceRef>hapus-out-4</bpmn:sourceRef>
        <bpmn:targetRef>d_komen</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="abaikan" name="Tutup laporan tanpa tindakan">
      <bpmn:ioSpecification id="abaikan-io">
        <bpmn:dataOutput id="abaikan-out-5" name="Laporan Konten" />
        <bpmn:inputSet id="abaikan-inputs" />
        <bpmn:outputSet id="abaikan-outputs">
          <bpmn:dataOutputRefs>abaikan-out-5</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="abaikan-doa-5">
        <bpmn:sourceRef>abaikan-out-5</bpmn:sourceRef>
        <bpmn:targetRef>d_lapkon</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gabung" />
    <bpmn:endEvent id="selesai" name="Laporan telah ditindaklanjuti">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Hasil_tindak_lanjut_laporan" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-lapor" name="ya" sourceRef="izin" targetRef="lapor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-lapor-tinjau" sourceRef="lapor" targetRef="tinjau" />
    <bpmn:sequenceFlow id="f-tinjau-keputusan" sourceRef="tinjau" targetRef="keputusan" />
    <bpmn:sequenceFlow id="f-keputusan-auth2" sourceRef="keputusan" targetRef="auth2" />
    <bpmn:sequenceFlow id="f-auth2-melanggar" sourceRef="auth2" targetRef="melanggar" />
    <bpmn:sequenceFlow id="f-melanggar-hapus" name="ya" sourceRef="melanggar" targetRef="hapus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">melanggar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-melanggar-abaikan" name="tidak" sourceRef="melanggar" targetRef="abaikan" />
    <bpmn:sequenceFlow id="f-hapus-gabung" sourceRef="hapus" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-abaikan-gabung" sourceRef="abaikan" targetRef="gabung" />
    <bpmn:sequenceFlow id="f-gabung-selesai" sourceRef="gabung" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_lapkon" name="Laporan Konten" dataStoreRef="d_lapkon-store" />
    <bpmn:dataStoreReference id="d_thread" name="Thread Diskusi" dataStoreRef="d_thread-store" />
    <bpmn:dataStoreReference id="d_komen" name="Komentar" dataStoreRef="d_komen-store" />
  </bpmn:process>
