<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Impor Dokumen UU (Kelola Konten Hukum)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Berkas_PDF_UU" name="Berkas PDF UU" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Pesan_PDF_tidak_terbaca" name="Pesan PDF tidak terbaca" />
  <bpmn:message id="Message_PDF_diunggah_ulang" name="PDF diunggah ulang" />
  <bpmn:message id="Message_Batal_impor" name="Batal impor" />
  <bpmn:message id="Message_Daftar_kesalahan_metadata" name="Daftar kesalahan metadata" />
  <bpmn:message id="Message_Metadata_diperbaiki" name="Metadata diperbaiki" />
  <bpmn:message id="Message_Konfirmasi_publikasi_UU" name="Konfirmasi publikasi UU" />
  <bpmn:dataStore id="d_uu-store" name="Undang-Undang" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Impor Dokumen UU" processRef="impor_dokumen_uu" />
    <bpmn:participant id="admin" name="Admin" />
    <bpmn:messageFlow id="m-admin-mulai" name="Berkas PDF UU" sourceRef="admin" targetRef="mulai" messageRef="Message_Berkas_PDF_UU" />
    <bpmn:messageFlow id="m-tolak-admin" name="Akses ditolak" sourceRef="tolak" targetRef="admin" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-gagalbaca-admin" name="Pesan PDF tidak terbaca" sourceRef="gagalbaca" targetRef="admin" messageRef="Message_Pesan_PDF_tidak_terbaca" />
    <bpmn:messageFlow id="m-admin-ulang" name="PDF diunggah ulang" sourceRef="admin" targetRef="ulang" messageRef="Message_PDF_diunggah_ulang" />
    <bpmn:messageFlow id="m-admin-batal" name="Batal impor" sourceRef="admin" targetRef="batal" messageRef="Message_Batal_impor" />
    <bpmn:messageFlow id="m-salah-admin" name="Daftar kesalahan metadata" sourceRef="salah" targetRef="admin" messageRef="Message_Daftar_kesalahan_metadata" />
    <bpmn:messageFlow id="m-admin-koreksi" name="Metadata diperbaiki" sourceRef="admin" targetRef="koreksi" messageRef="Message_Metadata_diperbaiki" />
    <bpmn:messageFlow id="m-selesai-admin" name="Konfirmasi publikasi UU" sourceRef="selesai" targetRef="admin" messageRef="Message_Konfirmasi_publikasi_UU" />
  </bpmn:collaboration>
  <bpmn:process id="impor_dokumen_uu" name="Impor Dokumen UU (Kelola Konten Hukum)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Berkas PDF UU diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Berkas_PDF_UU" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="urai" name="Uraikan PDF UU" />
    <bpmn:exclusiveGateway id="terbaca" name="PDF berhasil diuraikan?" default="f-terbaca-gagalbaca" />
    <bpmn:sendTask id="gagalbaca" name="Kirim pesan PDF tidak terbaca" messageRef="Message_Pesan_PDF_tidak_terbaca" />
    <bpmn:eventBasedGateway id="tunggu1" />
    <bpmn:intermediateCatchEvent id="ulang" name="Admin mengunggah ulang PDF">
      <bpmn:messageEventDefinition id="ulang-def" messageRef="Message_PDF_diunggah_ulang" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="batal" name="Admin membatalkan impor">
      <bpmn:messageEventDefinition id="batal-def" messageRef="Message_Batal_impor" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="dibatalkan" name="Impor dibatalkan" />
    <bpmn:serviceTask id="struktur" name="Ekstrak Struktur Dokumen" />
    <bpmn:serviceTask id="valid" name="Validasi Metadata UU">
      <bpmn:ioSpecification id="valid-io">
        <bpmn:dataInput id="valid-in-1" name="Undang-Undang" />
        <bpmn:inputSet id="valid-inputs">
          <bpmn:dataInputRefs>valid-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="valid-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="valid-dia-1">
        <bpmn:sourceRef>d_uu</bpmn:sourceRef>
        <bpmn:targetRef>valid-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="metaok" name="Metadata valid dan lengkap?" default="f-metaok-salah" />
    <bpmn:sendTask id="salah" name="Kirim daftar kesalahan metadata" messageRef="Message_Daftar_kesalahan_metadata" />
    <bpmn:receiveTask id="koreksi" name="Terima metadata yang diperbaiki" messageRef="Message_Metadata_diperbaiki" />
    <bpmn:serviceTask id="terbit" name="Terbitkan Dokumen UU">
      <bpmn:ioSpecification id="terbit-io">
        <bpmn:dataOutput id="terbit-out-2" name="Undang-Undang" />
        <bpmn:inputSet id="terbit-inputs" />
        <bpmn:outputSet id="terbit-outputs">
          <bpmn:dataOutputRefs>terbit-out-2</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="terbit-doa-2">
        <bpmn:sourceRef>terbit-out-2</bpmn:sourceRef>
        <bpmn:targetRef>d_uu</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Dokumen UU tersedia bagi pengguna">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_publikasi_UU" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-urai" name="ya" sourceRef="izin" targetRef="urai">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-urai-terbaca" sourceRef="urai" targetRef="terbaca" />
    <bpmn:sequenceFlow id="f-terbaca-struktur" name="ya" sourceRef="terbaca" targetRef="struktur">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pdfTerbaca</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-terbaca-gagalbaca" name="tidak" sourceRef="terbaca" targetRef="gagalbaca" />
    <bpmn:sequenceFlow id="f-gagalbaca-tunggu1" sourceRef="gagalbaca" targetRef="tunggu1" />
    <bpmn:sequenceFlow id="f-tunggu1-ulang" sourceRef="tunggu1" targetRef="ulang" />
    <bpmn:sequenceFlow id="f-tunggu1-batal" sourceRef="tunggu1" targetRef="batal" />
    <bpmn:sequenceFlow id="f-ulang-urai" sourceRef="ulang" targetRef="urai" />
    <bpmn:sequenceFlow id="f-batal-dibatalkan" sourceRef="batal" targetRef="dibatalkan" />
    <bpmn:sequenceFlow id="f-struktur-valid" sourceRef="struktur" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-metaok" sourceRef="valid" targetRef="metaok" />
    <bpmn:sequenceFlow id="f-metaok-terbit" name="ya" sourceRef="metaok" targetRef="terbit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">metadataValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-metaok-salah" name="tidak" sourceRef="metaok" targetRef="salah" />
    <bpmn:sequenceFlow id="f-salah-koreksi" sourceRef="salah" targetRef="koreksi" />
    <bpmn:sequenceFlow id="f-koreksi-valid" sourceRef="koreksi" targetRef="valid" />
    <bpmn:sequenceFlow id="f-terbit-selesai" sourceRef="terbit" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_uu" name="Undang-Undang" dataStoreRef="d_uu-store" />
  </bpmn:process>
