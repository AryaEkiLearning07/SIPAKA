tok 1.0 "Atur Visibilitas Entri (Kelola Repositori)"

pool p "Atur Visibilitas Entri" process=atur_visibilitas_entri
  store d_entri "Entri Repositori"
  start mulai "Pengaturan visibilitas diterima" message="Entri dan pilihan visibilitas"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  end tolak "Akses ditolak" message="Akses ditolak"
  xor pemilik "Pengguna pemilik entri?"
  end bukan "Pengaturan ditolak: bukan pemilik" message="Pengaturan ditolak"
  service simpan "Atur Visibilitas Entri"
  end selesai "Visibilitas entri diperbarui" message="Konfirmasi visibilitas diperbarui"

pool user "Pengguna"

flow mulai -> auth -> izin
flow izin -> pemilik "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow pemilik -> simpan "ya" when="pemilik"
flow pemilik -> bukan "tidak" default
flow simpan -> selesai

writes simpan d_entri

message user -> mulai "Entri dan pilihan visibilitas"
message tolak -> user "Akses ditolak"
message bukan -> user "Pengaturan ditolak"
message selesai -> user "Konfirmasi visibilitas diperbarui"
