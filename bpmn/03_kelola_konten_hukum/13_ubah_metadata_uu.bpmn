        <bpmndi:BPMNLabel>
          <dc:Bounds x="659" y="345" width="74" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_riw_di" bpmnElement="d_riw">
        <dc:Bounds x="821" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="798" y="345" width="96" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="m-admin-mulai_di" bpmnElement="m-admin-mulai">
        <di:waypoint x="78" y="410" />
        <di:waypoint x="78" y="88" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="83" y="237" width="102" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m-tolak-admin_di" bpmnElement="m-tolak-admin">
        <di:waypoint x="446" y="218" />
