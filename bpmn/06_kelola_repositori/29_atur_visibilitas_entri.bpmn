<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Atur Visibilitas Entri (Kelola Repositori)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Entri_dan_pilihan_visibilitas" name="Entri dan pilihan visibilitas" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Pengaturan_ditolak" name="Pengaturan ditolak" />
  <bpmn:message id="Message_Konfirmasi_visibilitas_diperbarui" name="Konfirmasi visibilitas diperbarui" />
  <bpmn:dataStore id="d_entri-store" name="Entri Repositori" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Atur Visibilitas Entri" processRef="atur_visibilitas_entri" />
    <bpmn:participant id="user" name="Pengguna" />
    <bpmn:messageFlow id="m-user-mulai" name="Entri dan pilihan visibilitas" sourceRef="user" targetRef="mulai" messageRef="Message_Entri_dan_pilihan_visibilitas" />
    <bpmn:messageFlow id="m-tolak-user" name="Akses ditolak" sourceRef="tolak" targetRef="user" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-bukan-user" name="Pengaturan ditolak" sourceRef="bukan" targetRef="user" messageRef="Message_Pengaturan_ditolak" />
    <bpmn:messageFlow id="m-selesai-user" name="Konfirmasi visibilitas diperbarui" sourceRef="selesai" targetRef="user" messageRef="Message_Konfirmasi_visibilitas_diperbarui" />
  </bpmn:collaboration>
  <bpmn:process id="atur_visibilitas_entri" name="Atur Visibilitas Entri (Kelola Repositori)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Pengaturan visibilitas diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Entri_dan_pilihan_visibilitas" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="pemilik" name="Pengguna pemilik entri?" default="f-pemilik-bukan" />
    <bpmn:endEvent id="bukan" name="Pengaturan ditolak: bukan pemilik">
      <bpmn:messageEventDefinition id="bukan-def" messageRef="Message_Pengaturan_ditolak" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="simpan" name="Atur Visibilitas Entri">
      <bpmn:ioSpecification id="simpan-io">
        <bpmn:dataOutput id="simpan-out-1" name="Entri Repositori" />
        <bpmn:inputSet id="simpan-inputs" />
        <bpmn:outputSet id="simpan-outputs">
          <bpmn:dataOutputRefs>simpan-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="simpan-doa-1">
        <bpmn:sourceRef>simpan-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_entri</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="selesai" name="Visibilitas entri diperbarui">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_visibilitas_diperbarui" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-pemilik" name="ya" sourceRef="izin" targetRef="pemilik">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-pemilik-simpan" name="ya" sourceRef="pemilik" targetRef="simpan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pemilik</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pemilik-bukan" name="tidak" sourceRef="pemilik" targetRef="bukan" />
    <bpmn:sequenceFlow id="f-simpan-selesai" sourceRef="simpan" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_entri" name="Entri Repositori" dataStoreRef="d_entri-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
