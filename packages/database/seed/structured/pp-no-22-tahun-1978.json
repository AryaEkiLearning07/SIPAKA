{
 "slug": "pp-no-22-tahun-1978",
 "preamble": {
  "menimbang": [
   "bahwa perkembangan dan kemajuan wilayah Kecamatan Kupang telah menunjukkan ciri dan sifat penghidupan perkotaan yang memerlukan pembinaan serta pengaturan penyelenggaraan pemerintahannya secara khusus;",
   "bahwa sesuai dengan ketentuan tersebut dalam Pasal 72 ayat (4) Undang-undang Nomor 5 Tahun 1974 tentang Pokok-pokok Pemerintahan Di Daerah, maka pembentukan Kota Administratif Kupang perlu ditetapkan dengan Peraturan Pemerintah;"
  ],
  "mengingat": []
 },
