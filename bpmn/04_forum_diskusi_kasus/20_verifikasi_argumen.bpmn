<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Verifikasi Argumen (Forum Diskusi Kasus)" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Argumen_yang_dipilih" name="Argumen yang dipilih" />
  <bpmn:message id="Message_Akses_ditolak" name="Akses ditolak" />
  <bpmn:message id="Message_Argumen_untuk_ditinjau" name="Argumen untuk ditinjau" />
  <bpmn:message id="Message_Keputusan_verifikasi" name="Keputusan verifikasi" />
  <bpmn:message id="Message_Konfirmasi_verifikasi" name="Konfirmasi verifikasi" />
  <bpmn:message id="Message_Argumen_tidak_diverifikasi" name="Argumen tidak diverifikasi" />
  <bpmn:dataStore id="d_komen-store" name="Komentar" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Verifikasi Argumen" processRef="verifikasi_argumen" />
    <bpmn:participant id="dosen" name="Dosen/Ahli" />
    <bpmn:messageFlow id="m-dosen-mulai" name="Argumen yang dipilih" sourceRef="dosen" targetRef="mulai" messageRef="Message_Argumen_yang_dipilih" />
    <bpmn:messageFlow id="m-tolak-dosen" name="Akses ditolak" sourceRef="tolak" targetRef="dosen" messageRef="Message_Akses_ditolak" />
    <bpmn:messageFlow id="m-tinjau-dosen" name="Argumen untuk ditinjau" sourceRef="tinjau" targetRef="dosen" messageRef="Message_Argumen_untuk_ditinjau" />
    <bpmn:messageFlow id="m-dosen-hasil" name="Keputusan verifikasi" sourceRef="dosen" targetRef="hasil" messageRef="Message_Keputusan_verifikasi" />
    <bpmn:messageFlow id="m-selesai-dosen" name="Konfirmasi verifikasi" sourceRef="selesai" targetRef="dosen" messageRef="Message_Konfirmasi_verifikasi" />
    <bpmn:messageFlow id="m-ditolak-dosen" name="Argumen tidak diverifikasi" sourceRef="ditolak" targetRef="dosen" messageRef="Message_Argumen_tidak_diverifikasi" />
  </bpmn:collaboration>
  <bpmn:process id="verifikasi_argumen" name="Verifikasi Argumen (Forum Diskusi Kasus)" isExecutable="false">
    <bpmn:startEvent id="mulai" name="Permintaan verifikasi diterima">
      <bpmn:messageEventDefinition id="mulai-def" messageRef="Message_Argumen_yang_dipilih" />
    </bpmn:startEvent>
    <bpmn:callActivity id="auth" name="Otorisasi Akses" calledElement="otorisasi_akses" />
    <bpmn:exclusiveGateway id="izin" name="Akses diizinkan (peran dosen/ahli)?" default="f-izin-tolak" />
    <bpmn:endEvent id="tolak" name="Akses ditolak">
      <bpmn:messageEventDefinition id="tolak-def" messageRef="Message_Akses_ditolak" />
    </bpmn:endEvent>
    <bpmn:sendTask id="tinjau" name="Tinjau Argumen Hukum" messageRef="Message_Argumen_untuk_ditinjau" />
    <bpmn:receiveTask id="hasil" name="Terima keputusan verifikasi" messageRef="Message_Keputusan_verifikasi" />
    <bpmn:exclusiveGateway id="sesuai" name="Argumen sesuai hukum?" default="f-sesuai-ditolak" />
    <bpmn:serviceTask id="tandai" name="Tandai Argumen Terverifikasi">
      <bpmn:ioSpecification id="tandai-io">
        <bpmn:dataOutput id="tandai-out-1" name="Komentar" />
        <bpmn:inputSet id="tandai-inputs" />
        <bpmn:outputSet id="tandai-outputs">
          <bpmn:dataOutputRefs>tandai-out-1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="tandai-doa-1">
        <bpmn:sourceRef>tandai-out-1</bpmn:sourceRef>
        <bpmn:targetRef>d_komen</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="lencana" name="Lampirkan Lencana Verifikasi">
      <bpmn:ioSpecification id="lencana-io">
        <bpmn:dataOutput id="lencana-out-2" name="Komentar" />
        <bpmn:inputSet id="lencana-inputs" />
        <bpmn:outputSet id="lencana-outputs">
          <bpmn:dataOutputRefs>lencana-out-2</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="lencana-doa-2">
        <bpmn:sourceRef>lencana-out-2</bpmn:sourceRef>
        <bpmn:targetRef>d_komen</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="poin" name="Beri Poin Reputasi" calledElement="kelola_reputasi">
      <bpmn:documentation>Langkah 'Beri Poin Reputasi' pada proses Kelola Reputasi (untuk penulis argumen)</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:endEvent id="selesai" name="Argumen terverifikasi">
      <bpmn:messageEventDefinition id="selesai-def" messageRef="Message_Konfirmasi_verifikasi" />
    </bpmn:endEvent>
    <bpmn:endEvent id="ditolak" name="Argumen tidak diverifikasi">
      <bpmn:messageEventDefinition id="ditolak-def" messageRef="Message_Argumen_tidak_diverifikasi" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-mulai-auth" sourceRef="mulai" targetRef="auth" />
    <bpmn:sequenceFlow id="f-auth-izin" sourceRef="auth" targetRef="izin" />
    <bpmn:sequenceFlow id="f-izin-tinjau" name="ya" sourceRef="izin" targetRef="tinjau">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aksesDiizinkan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-izin-tolak" name="tidak" sourceRef="izin" targetRef="tolak" />
    <bpmn:sequenceFlow id="f-tinjau-hasil" sourceRef="tinjau" targetRef="hasil" />
    <bpmn:sequenceFlow id="f-hasil-sesuai" sourceRef="hasil" targetRef="sesuai" />
    <bpmn:sequenceFlow id="f-sesuai-tandai" name="ya" sourceRef="sesuai" targetRef="tandai">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">argumenSesuai</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sesuai-ditolak" name="tidak" sourceRef="sesuai" targetRef="ditolak" />
    <bpmn:sequenceFlow id="f-tandai-lencana" sourceRef="tandai" targetRef="lencana" />
    <bpmn:sequenceFlow id="f-lencana-poin" sourceRef="lencana" targetRef="poin" />
    <bpmn:sequenceFlow id="f-poin-selesai" sourceRef="poin" targetRef="selesai" />
    <bpmn:dataStoreReference id="d_komen" name="Komentar" dataStoreRef="d_komen-store" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="p_di" bpmnElement="p" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1320" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dosen_di" bpmnElement="dosen" isHorizontal="true">
        <dc:Bounds x="0" y="280" width="1320" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai">
