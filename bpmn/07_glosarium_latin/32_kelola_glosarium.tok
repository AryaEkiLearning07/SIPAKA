tok 1.0 "Kelola Glosarium (Glosarium Latin)"

pool p "Kelola Glosarium" process=kelola_glosarium
  store d_istilah "Istilah Latin"
  start mulai "Permintaan kelola glosarium diterima" message="Aksi dan data istilah glosarium"
  call auth "Otorisasi Akses" process=otorisasi_akses
  xor izin "Akses diizinkan?"
  end tolak "Akses ditolak" message="Akses ditolak"
  xor aksi "Aksi glosarium?"
  service valid "Validasi data istilah (tidak duplikat, definisi terisi)"
  xor ok "Data istilah valid?"
  send pesan "Kirim pesan kesalahan data istilah" message="Pesan kesalahan data istilah"
  receive perbaiki "Terima data istilah yang diperbaiki" message="Data istilah diperbaiki"
  service tambah "Tambah Istilah Glosarium"
  service ubah "Ubah Istilah Glosarium"
  send minta "Minta konfirmasi penghapusan istilah" message="Permintaan konfirmasi hapus"
  eventgw tunggu
  catch ya "Admin mengonfirmasi hapus" message="Konfirmasi hapus"
  catch tidak "Admin membatalkan hapus" message="Batal hapus"
  service hapus "Hapus Istilah Glosarium"
  xor gabung
  end selesai "Glosarium diperbarui" message="Konfirmasi glosarium diperbarui"
  end batal "Penghapusan dibatalkan"

pool admin "Admin"

flow mulai -> auth -> izin
flow izin -> aksi "ya" when="aksesDiizinkan"
flow izin -> tolak "tidak" default
flow aksi -> valid "tambah atau ubah" when="aksi = \"tambah\" or aksi = \"ubah\""
flow aksi -> minta "hapus" default
flow valid -> ok
flow ok -> tambah "ya, tambah" when="aksi = \"tambah\""
flow ok -> ubah "ya, ubah" when="aksi = \"ubah\""
flow ok -> pesan "tidak" default
flow pesan -> perbaiki -> valid
flow minta -> tunggu
flow tunggu -> ya
flow tunggu -> tidak
flow ya -> hapus -> gabung
flow tidak -> batal
flow tambah -> gabung
flow ubah -> gabung
flow gabung -> selesai

reads valid d_istilah
writes tambah d_istilah
writes ubah d_istilah
writes hapus d_istilah

message admin -> mulai "Aksi dan data istilah glosarium"
message tolak -> admin "Akses ditolak"
message pesan -> admin "Pesan kesalahan data istilah"
message admin -> perbaiki "Data istilah diperbaiki"
message minta -> admin "Permintaan konfirmasi hapus"
message admin -> ya "Konfirmasi hapus"
message admin -> tidak "Batal hapus"
message selesai -> admin "Konfirmasi glosarium diperbarui"
